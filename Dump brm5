-- =================================================================
-- SYSTEM HOOKS (DYNAMIC NETWORK EVENT SPY)
-- =================================================================
local hasNetworkSpyHook = false
local spyInitialized = false

function initializeNetworkSpy()
	if spyInitialized then return end
	spyInitialized = true

	pcall(function()
		local remoteEvent = Instance.new("RemoteEvent")
		if hookfunction and remoteEvent.FireServer then
			local oldFireServer
			oldFireServer = hookfunction(remoteEvent.FireServer, function(self, ...)
				if Config.NetworkSpyActive then
					local args = { ... }
					task.spawn(function()
						local argStrings = {}
						for i, arg in ipairs(args) do
							table.insert(argStrings, string.format("[%d] (%s) %s", i, type(arg), tostring(arg)))
						end
						local logMsg = string.format(
							"[NETWORK EVENT] %s:FireServer()\nArguments:\n%s",
							self:GetFullName(),
							table.concat(argStrings, "\n")
						)
						logToFile(OUT_DIR .. "/network_remotes.log", logMsg)
						addLog(string.format("📡 [EVENT] %s", self.Name), Color3.fromRGB(80, 220, 240))
					end)
				end
				return oldFireServer(self, ...)
			end)
			hasNetworkSpyHook = true
		end
	end)

	pcall(function()
		local remoteFunc = Instance.new("RemoteFunction")
		if hookfunction and remoteFunc.InvokeServer then
			local oldInvokeServer
			oldInvokeServer = hookfunction(remoteFunc.InvokeServer, function(self, ...)
				if Config.NetworkSpyActive then
					local args = { ... }
					task.spawn(function()
						local argStrings = {}
						for i, arg in ipairs(args) do
							table.insert(argStrings, string.format("[%d] (%s) %s", i, type(arg), tostring(arg)))
						end
						local logMsg = string.format(
							"[NETWORK FUNCTION] %s:InvokeServer()\nArguments:\n%s",
							self:GetFullName(),
							table.concat(argStrings, "\n")
						)
						logToFile(OUT_DIR .. "/network_remotes.log", logMsg)
						addLog(string.format("📡 [FUNC] %s", self.Name), Color3.fromRGB(240, 220, 80))
					end)
				end
				return oldInvokeServer(self, ...)
			end)
			hasNetworkSpyHook = true
		end
	end)

	if hasNetworkSpyHook then
		addLog("[SYS] Network Remote Spy successfully activated.", Color3.fromRGB(80, 250, 200))
	else
		addLog("[SYS] Activation failed (no hookfunction in executor).", Color3.fromRGB(250, 100, 100))
	end
end

