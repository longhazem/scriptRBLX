	ensureDir(OUT_DIR)

	-- ══════════════════════════════════════════════════════════════
	-- ETAP 1: SKANOWANIE
	-- ══════════════════════════════════════════════════════════════
	setProgress("PHASE 1/3: Scanning all sources...")
	addLog("", Color3.fromRGB(40, 40, 40))
	addLog("╔══════════════════════════════════════╗", Color3.fromRGB(150, 80, 255))
	addLog("║  ⚡ PHASE 1: SCANNING (6 methods)     ║", Color3.fromRGB(150, 80, 255))
