	resetPhaseUI()
	lastYield = os.clock()

	local startTime = os.clock()
	addLog("=== SUPER DUMPER V5 – 4-PHASE SYSTEM (WITH TOOL 2) ===", Color3.fromRGB(150, 80, 255))
	addLog(string.format(
		"[SYS] decompile=%s | getscriptbytecode=%s | getscripts=%s | getinstances=%s | hookfunction=%s",
		tostring(decompile ~= nil),
		tostring(getscriptbytecode ~= nil),
		tostring(getscripts ~= nil),
		tostring(getinstances ~= nil),
		tostring(hookfunction ~= nil)
