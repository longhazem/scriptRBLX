local phaseRows = {
	scan      = createPhaseRow("1", "🔍 Scanning"),
	decompile = createPhaseRow("2", "🧪 Decompiling"),
	write     = createPhaseRow("3", "📁 Saving"),
}

local setPhaseStatus, markPhaseActive, markPhaseDone, resetPhaseUI

setPhaseStatus = function(key, countOrText, total)
	local row = phaseRows[key]
	if not row then return end
	if total then
		row.statusLbl.Text = tostring(countOrText) .. "/" .. tostring(total)
	else
		row.statusLbl.Text = tostring(countOrText)
	end
end

markPhaseActive = function(key)
	local row = phaseRows[key]
	if not row then return end
	TweenService:Create(row.row,    TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(28, 20, 45) }):Play()
	TweenService:Create(row.stroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(150, 80, 255), Thickness = 1.5 }):Play()
	row.numLbl.TextColor3    = Color3.fromRGB(180, 100, 255)
	row.nameLbl.TextColor3   = Color3.fromRGB(220, 220, 240)
	row.statusLbl.Text       = "▶ Active"
	row.statusLbl.TextColor3 = Color3.fromRGB(180, 100, 255)
end

markPhaseDone = function(key, count)
	local row = phaseRows[key]
	if not row then return end
	TweenService:Create(row.row,    TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(14, 28, 18) }):Play()
	TweenService:Create(row.stroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(80, 255, 140), Thickness = 1 }):Play()
	row.numLbl.TextColor3    = Color3.fromRGB(80, 255, 140)
	row.nameLbl.TextColor3   = Color3.fromRGB(200, 240, 210)
	row.statusLbl.Text       = "✓ " .. tostring(count)
	row.statusLbl.TextColor3 = Color3.fromRGB(80, 255, 140)
end

resetPhaseUI = function()
	for _, key in ipairs({ "scan", "decompile", "write" }) do
		local row = phaseRows[key]
		if row then
			TweenService:Create(row.row,    TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(18, 18, 26) }):Play()
			TweenService:Create(row.stroke, TweenInfo.new(0.3), { Color = Color3.fromRGB(40, 40, 55), Thickness = 1 }):Play()
			row.numLbl.TextColor3    = Color3.fromRGB(100, 100, 120)
			row.nameLbl.TextColor3   = Color3.fromRGB(150, 150, 170)
			row.statusLbl.Text       = "Wait..."
			row.statusLbl.TextColor3 = Color3.fromRGB(80, 80, 100)
		end
	end
end

