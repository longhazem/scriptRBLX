-- Get full 1:1 game path from instance using GetFullName()
local function getFullGamePath(inst)
	local ok, fn = pcall(function() return inst:GetFullName() end)
	if not ok or not fn or fn == "" then return "" end
	-- Remove "game." prefix → "ReplicatedStorage.Folder.Script"
	fn = fn:gsub("^game%.", ""):gsub("^game$", "")
	-- Split by dots and sanitize each segment
	local parts = string.split(fn, ".")
	local safeParts = {}
	for _, p in ipairs(parts) do
		local sp = safeStr(p)
		if sp ~= "" then table.insert(safeParts, sp) end
	end
	if #safeParts == 0 then return "" end
	return table.concat(safeParts, "/")
end

-- =================================================================
-- PHASE 1: SCAN - Collect all unique scripts
-- =================================================================
local function runScanPhase()
	local queue    = {}     -- { inst, bc, tag }
	local seenPtr  = {}     -- [instance] = true (pointer dedup)
	local scanTotal = 0

	local function isScriptType(inst)
		local ok, r = pcall(function()
			return inst:IsA("LocalScript") or inst:IsA("ModuleScript") or inst:IsA("Script")
		end)
		return ok and r
	end

	local function tryAddToQueue(inst, tag)
		if seenPtr[inst] then return end

		-- Get bytecode for hash deduplication
		local bc = ""
		if getscriptbytecode then
			local realI = unwrapProxy(inst) or inst
			for _, target in ipairs({ realI, inst }) do
				local ok, b = pcall(getscriptbytecode, target)
				if ok and b and type(b) == "string" and #b > 4 then
					bc = b
					break
				end
			end
		end

		-- Bytecode hash dedup
		if bc ~= "" then
			local hash = bcHash(bc)
			if hash and global_seen_bc[hash] then
				total_skip += 1
				updateStats()
				return
			end
			if hash then global_seen_bc[hash] = true end
		end

		seenPtr[inst] = true
		table.insert(queue, { inst = inst, bc = bc, tag = tag })
		scanTotal += 1
		setPhaseStatus("scan", scanTotal)
	end

	-- ── Metoda 1: getscripts() ──────────────────────────────────
	addLog("── [M1] getscripts()", Color3.fromRGB(150, 80, 255))
	if getscripts then
		local ok, scripts = pcall(getscripts)
		if ok and scripts then
			for _, s in ipairs(scripts) do
				if isScriptType(s) then tryAddToQueue(s, "getscripts") end
				checkYield()
			end
			addLog(string.format("     → %d scripts", #scripts), Color3.fromRGB(100, 200, 255))
		else
			addLog("     [ERR] " .. tostring(scripts), Color3.fromRGB(220, 80, 80))
		end
	else
		addLog("     [SKIP] unavailable", Color3.fromRGB(120, 120, 120))
	end

	-- ── Metoda 2: getloadedmodules() ───────────────────────────
	addLog("── [M2] getloadedmodules()", Color3.fromRGB(150, 80, 255))
	if getloadedmodules then
		local ok, mods = pcall(getloadedmodules)
		if ok and mods then
			for _, m in ipairs(mods) do
				if isScriptType(m) then tryAddToQueue(m, "loadedmodules") end
				checkYield()
			end
			addLog(string.format("     → %d modules", #mods), Color3.fromRGB(100, 200, 255))
		else
			addLog("     [SKIP] no modules", Color3.fromRGB(120, 120, 120))
		end
	else
		addLog("     [SKIP] unavailable", Color3.fromRGB(120, 120, 120))
	end

	-- ── Metoda 3: getinstances() ────────────────────────────────
	addLog("── [M3] getinstances()", Color3.fromRGB(150, 80, 255))
	if getinstances then
		local ok, insts = pcall(getinstances)
		if ok and insts then
			local cnt = 0
			for _, inst in ipairs(insts) do
				if isScriptType(inst) then tryAddToQueue(inst, "getinstances"); cnt += 1 end
				checkYield()
			end
			addLog(string.format("     → %d scripts", cnt), Color3.fromRGB(100, 200, 255))
		else
			addLog("     [SKIP] no instances", Color3.fromRGB(120, 120, 120))
		end
	else
		addLog("     [SKIP] unavailable", Color3.fromRGB(120, 120, 120))
	end

	-- ── Metoda 4: getnilinstances() ─────────────────────────────
	addLog("── [M4] getnilinstances()", Color3.fromRGB(150, 80, 255))
	if getnilinstances then
		local ok, nils = pcall(getnilinstances)
		if ok and nils then
			local cnt = 0
			for _, inst in ipairs(nils) do
				if isScriptType(inst) then tryAddToQueue(inst, "nilinstances"); cnt += 1 end
				checkYield()
			end
			addLog(string.format("     → %d nil-scripts", cnt), Color3.fromRGB(100, 200, 255))
		else
			addLog("     [SKIP] no nil-instances", Color3.fromRGB(120, 120, 120))
		end
	else
		addLog("     [SKIP] unavailable", Color3.fromRGB(120, 120, 120))
	end

	-- ── Method 5: GC - script instances ────────────────────────
	addLog("── [M5] getgc() – script instances", Color3.fromRGB(150, 80, 255))
	local okGC, gcData = pcall(getgc, true)
	if okGC and gcData then
		local cnt = 0
		for _, v in next, gcData do
			if type(v) == "userdata" then
				local ok2, tn = pcall(typeof, v)
				if ok2 and tn == "Instance" and isScriptType(v) then
					tryAddToQueue(v, "gc_instances")
					cnt += 1
				end
			end
			if _ % 5000 == 0 then checkYield() end
		end
		addLog(string.format("     → %d scripts in GC", cnt), Color3.fromRGB(100, 200, 255))
	else
		addLog("     [SKIP] getgc() unavailable", Color3.fromRGB(120, 120, 120))
	end

	-- ── Metoda 6: Game Tree Walk (wszystkie serwisy) ─────────────
	addLog("── [M6] Game Tree Walk", Color3.fromRGB(150, 80, 255))
	local serviceNames = {
		"Workspace","ReplicatedStorage","ReplicatedFirst","StarterGui",
		"StarterPack","StarterPlayer","Teams","SoundService","Chat",
		"Players","ServerScriptService","ServerStorage","Lighting","MaterialService",
	}
	for _, svcName in ipairs(serviceNames) do
		if Config.Services[svcName] == false then continue end
		local ok0, svc = pcall(function() return game:GetService(svcName) end)
		if not ok0 or not svc then continue end
		local okD, desc = pcall(function() return svc:GetDescendants() end)
		if okD and desc then
			local cnt = 0
			for _, inst in ipairs(desc) do
				if isScriptType(inst) then tryAddToQueue(inst, "gametree_" .. svcName); cnt += 1 end
				checkYield()
			end
			if cnt > 0 then
				addLog(string.format("     %s: %d scripts", svcName, cnt), Color3.fromRGB(100, 200, 255))
			end
		end
		checkYield()
	end

	addLog(string.format("✓ Scanning: %d unique scripts collected.", #queue), Color3.fromRGB(80, 255, 140))
	return queue
end

-- =================================================================
-- PHASE 2: DECOMPILE - Decompile all collected scripts
-- =================================================================
local function runDecompilePhase(queue)
	local results    = {}  -- { name, src, bc, gamePath, tag }
	local gcClosures = {}  -- { name, src }
	local seen_closure_key = {}
	local doneCount  = 0

	addLog(string.format("Decompiling %d scripts...", #queue), Color3.fromRGB(100, 200, 255))

	for _, item in ipairs(queue) do
		local inst     = item.inst
		local bc       = item.bc
		local realInst = unwrapProxy(inst) or inst

		-- Get name
		local name = ""
		pcall(function() name = realInst.Name end)
		if name == "" then pcall(function() name = inst.Name end) end
		local baseName = safeStr(name)

		-- Name filter
		if Config.NameFilterActive and Config.NameFilterText ~= "" then
			if not string.find(string.lower(baseName), string.lower(Config.NameFilterText), 1, true) then
				total_skip += 1; updateStats()
				doneCount += 1; setPhaseStatus("decompile", doneCount, #queue)
				continue
			end
		end

		-- Size filter
		if bc ~= "" and #bc > Config.MaxFileSize then
			addLog("[SKIP:SIZE] " .. baseName, Color3.fromRGB(240, 100, 100))
			total_skip += 1; updateStats()
			doneCount += 1; setPhaseStatus("decompile", doneCount, #queue)
			continue
		end

		-- Get 1:1 game path via GetFullName
		local gamePath = getFullGamePath(realInst)
		if gamePath == "" then gamePath = getFullGamePath(inst) end

		-- Decompile
		local src = nil
		local skipDueToFilter = false

		if Config.Decompile then
			if Config.UseMedalDecompiler and bc and #bc > 0 then
				local http_req = request or http_request or (syn and syn.request) or (http and http.request)
				if http_req then
					local ok, res = pcall(http_req, {
						Url = "http://127.0.0.1:3000/luau/decompile",
						Method = "POST",
						Body = bc,
						Headers = { ["Content-Type"] = "application/octet-stream" }
					})
					if ok and res and res.StatusCode == 200 and res.Body and not isUselessSrc(res.Body) then
						local dec = cleanSource(res.Body)
						if Config.KeywordFilterActive and Config.KeywordFilterText ~= "" then
							if not string.find(string.lower(dec), string.lower(Config.KeywordFilterText), 1, true) then
								skipDueToFilter = true
							end
						end
						if not skipDueToFilter then
							src = dec
						end
					else
						local errMsg = "Error"
						if not ok then errMsg = tostring(res)
						elseif res then errMsg = "HTTP " .. tostring(res.StatusCode) .. " " .. tostring(res.Body) end
						addLog("[MEDAL ERR] " .. baseName .. " -> " .. string.sub(errMsg, 1, 60), Color3.fromRGB(240, 100, 100))
						logToFile(OUT_DIR .. "/decompile_errors.log", "Name: " .. baseName .. "\nPath: " .. gamePath .. "\nMedal Error: " .. tostring(errMsg))
					end
				else
					addLog("[MEDAL ERR] Brak funkcji HTTP (request)", Color3.fromRGB(240, 100, 100))
				end
			end

			if not src and not skipDueToFilter and decompile then
				for _, target in ipairs({ realInst, inst }) do
					local ok, dec = pcall(decompile, target)
					if ok and dec and not isUselessSrc(dec) then
						dec = cleanSource(dec)
						-- Keyword filter
						if Config.KeywordFilterActive and Config.KeywordFilterText ~= "" then
							if not string.find(string.lower(dec), string.lower(Config.KeywordFilterText), 1, true) then
								skipDueToFilter = true
								break
							end
						end
						src = dec
						break
					elseif not ok and dec then
						logToFile(OUT_DIR .. "/decompile_errors.log",
							"Name: " .. baseName .. "\nPath: " .. gamePath .. "\nError: " .. tostring(dec))
					end
				end
			end
		end

		if skipDueToFilter then
			total_skip += 1; updateStats()
			doneCount += 1; setPhaseStatus("decompile", doneCount, #queue)
			continue
		end

		doneCount += 1
		setPhaseStatus("decompile", doneCount, #queue)

		if src or (Config.FallbackBytecode and bc ~= "") then
			table.insert(results, {
				name     = baseName,
				src      = src,
				bc       = bc,
				gamePath = gamePath,
				tag      = item.tag,
			})
		else
			total_skip += 1
			updateStats()
		end

		checkYield()
	end

	-- GC Closure scan (functions in memory, not bound to instances)
	addLog("── GC Closure scan...", Color3.fromRGB(150, 80, 255))
	local okGC, gcData = pcall(getgc, true)
	if okGC and gcData and decompile then
		local closureCnt = 0
		for _, v in next, gcData do
			if type(v) == "function" then
				local info
				pcall(function() info = debug.getinfo(v) end)
				if info and info.source and not string.match(info.source, "^%[C%]") then
					local key = info.source .. ":" .. tostring(info.linedefined or 0)
					if not seen_closure_key[key] then
						seen_closure_key[key] = true
						local ok2, dec = pcall(decompile, v)
						if ok2 and not isUselessSrc(dec) then
							dec = cleanSource(dec)
							local cleanSrc = safeStr(
								string.match(string.gsub(info.source, "^[@=]", ""), "[^/\\]+$") or info.source
							)
							table.insert(gcClosures, {
								name = cleanSrc .. "_L" .. tostring(info.linedefined or 0),
								src  = dec,
							})
							closureCnt += 1
						end
					end
				end
			end
			if _ % 5000 == 0 then checkYield() end
		end
		addLog(string.format("     → %d GC closures decompiled", closureCnt), Color3.fromRGB(100, 200, 255))
	end

	addLog(string.format("✓ Decompiling: %d results, %d GC closures.", #results, #gcClosures), Color3.fromRGB(80, 255, 140))
	return results, gcClosures
end

-- =================================================================
-- PHASE 3: WRITE - Save with exact 1:1 game tree structure
-- =================================================================
local function runWritePhase(results, gcClosures)
	local treeBase = OUT_DIR .. "/game_tree_1to1"
	ensureDir(OUT_DIR)
	ensureDir(treeBase)

	addLog(string.format("Writing %d scripts with 1:1 structure...", #results), Color3.fromRGB(100, 200, 255))

	for i, item in ipairs(results) do
		local name     = item.name
		local src      = item.src
		local bc       = item.bc
		local gamePath = item.gamePath  -- e.g. "ReplicatedStorage/WeaponSystem/ClientHandler"
		local tag      = item.tag or "unknown"

		-- Build folder from gamePath
		-- gamePath = "Service/Folder1/Folder2/ScriptName"
		-- → folder = treeBase/Service/Folder1/Folder2/
		-- → file   = treeBase/Service/Folder1/Folder2/ScriptName.lua
		local folderPath

		if gamePath ~= "" then
			local parts = string.split(gamePath, "/")
			if #parts > 1 then
				local folderParts = {}
				for j = 1, #parts - 1 do
					table.insert(folderParts, parts[j])
				end
				folderPath = treeBase .. "/" .. table.concat(folderParts, "/")
			else
				-- Single-level (script at root of service)
				folderPath = treeBase
			end
		else
			-- Unknown path → misc folder tagged by scan source
			folderPath = treeBase .. "/_misc/" .. safeStr(tag)
		end

		local writePath = folderPath .. "/" .. name

		if src then
			-- Threat scan
			if Config.ScanThreats then
				for _, threat in ipairs(ThreatKeywords) do
					if string.find(src, threat.pattern) then
						local preview = getLinePreview(src, threat.pattern)
						logToFile(OUT_DIR .. "/scanned_threats.log", string.format(
							"[POTENTIAL THREAT]\nScript: %s\nGamePath: %s\nType: %s\nPreview: %s",
							name .. ".lua", gamePath, threat.name, preview
						))
					end
				end
			end

			local finalPath = getUniquePath(writePath, ".lua")
			pcall(createFoldersForPath, finalPath)
			pcall(ensureDir, folderPath)
			local wok = pcall(writefile, finalPath, src)
			if wok then
				local shortPath = gamePath ~= "" and gamePath or ("_misc/" .. tag)
				if #shortPath > 55 then shortPath = "..." .. string.sub(shortPath, -52) end
				addLog("[✓] " .. name .. " → " .. shortPath, Color3.fromRGB(80, 255, 140))
				total_lua += 1
				updateStats()
			else
				addLog("[ERR:WRITE] " .. name, Color3.fromRGB(220, 80, 80))
				total_skip += 1
				updateStats()
			end
		elseif Config.FallbackBytecode and bc ~= "" then
			local finalPath = getUniquePath(writePath, ".luac")
			pcall(createFoldersForPath, finalPath)
			pcall(ensureDir, folderPath)
			local wok = pcall(writefile, finalPath, bc)
			if wok then
				addLog("[BC] " .. name .. ".luac", Color3.fromRGB(160, 100, 255))
				total_luac += 1
				updateStats()
			end
		else
			addLog("[FAIL] " .. name, Color3.fromRGB(220, 80, 80))
			total_skip += 1
			updateStats()
		end

		setPhaseStatus("write", i, #results)
		checkYield()
	end

	-- Write GC closures to separate folder
	if #gcClosures > 0 then
		local gcBase = OUT_DIR .. "/gc_closures"
		ensureDir(gcBase)
		addLog(string.format("Writing %d GC closures...", #gcClosures), Color3.fromRGB(150, 100, 220))
		for _, item in ipairs(gcClosures) do
			local basePath = gcBase .. "/" .. item.name
			local fname = getUniquePath(basePath, ".lua")
			local wok = pcall(writefile, fname, item.src)
			if wok then
				addLog("[GC] " .. (string.match(fname, "[^/]+$") or item.name), Color3.fromRGB(150, 100, 220))
				total_lua += 1
				updateStats()
			end
			checkYield()
		end
	end
end

-- =================================================================
-- PHASE 4: REMOTE SPY DUMPER (TOOL 2)
-- =================================================================

local remoteSpyData = {}
local remoteInvocationCount = {}

local function argumentsToHexDump(args)
	local argStrings = {}
	for i, arg in ipairs(args) do
		table.insert(argStrings, tostring(arg))
	end
	local combined = "[" .. table.concat(argStrings, ",") .. "]"
	local hex = ""
	local hexLine = ""
	for i = 1, #combined do
		hexLine = hexLine .. string.format("%02X ", string.byte(combined, i))
		if i % 16 == 0 then
			hex = hex .. hexLine .. "\n"
			hexLine = ""
		end
	end
	if hexLine ~= "" then hex = hex .. hexLine end
	return hex, combined
end

local function serializeArg(arg, depth)
	depth = depth or 0
	if depth > 5 then return "..." end
	
	if arg == nil then return "nil"
	elseif type(arg) == "boolean" then return tostring(arg)
	elseif type(arg) == "number" then return tostring(arg)
	elseif type(arg) == "string" then return '"' .. arg .. '"'
	elseif type(arg) == "table" then
		local result = "{"
		local count = 0
		for k, v in pairs(arg) do
			if count > 0 then result = result .. ", " end
			if type(k) == "string" then
				result = result .. k .. " = " .. serializeArg(v, depth + 1)
			else
				result = result .. "[" .. tostring(k) .. "] = " .. serializeArg(v, depth + 1)
			end
			count = count + 1
			if count >= 15 then
				result = result .. ", ..."
				break
			end
		end
		result = result .. "}"
		return result
	elseif typeof(arg) == "CFrame" then
		local x, y, z = arg.X, arg.Y, arg.Z
		return string.format("CFrame.new(%.2f, %.2f, %.2f)", x, y, z)
	else
		return tostring(typeof(arg)) .. ": " .. tostring(arg)
	end
end

local function captureRemoteCall(remoteName, direction, method, args)
	if not remoteInvocationCount[remoteName] then
		remoteInvocationCount[remoteName] = 0
		remoteSpyData[remoteName] = {
			name = remoteName,
			direction = direction,
			method = method,
			calls = {}
		}
	end
	
	remoteInvocationCount[remoteName] = remoteInvocationCount[remoteName] + 1
	
	local hex, combined = argumentsToHexDump(args)
	
	table.insert(remoteSpyData[remoteName].calls, {
		timestamp = os.time(),
		arguments = args,
		hexDump = hex,
		combined = combined
	})
end

local function writeRemoteSpyFiles()
	local remoteDir = OUT_DIR .. "/remotes_dumped"
	ensureDir(remoteDir)
	
	local totalWritten = 0
	
	for remoteName, data in pairs(remoteSpyData) do
		local invocations = remoteInvocationCount[remoteName] or 0
		
		local content = string.format(
			"-- ============================================================================\n" ..
			"-- REMOTE SPY DUMP - %s\n" ..
			"-- Direction: %s | Method: %s | Total Invocations: %d\n" ..
			"-- Generated: %s\n" ..
			"-- ============================================================================\n\n",
			remoteName,
			data.direction,
			data.method,
			invocations,
			os.date("%Y-%m-%d %H:%M:%S")
		)
		
		for idx, call in ipairs(data.calls) do
			content = content .. string.format(
				"-- [CALL #%d] %s\n" ..
				"-- Arguments (%d total):\n",
				idx,
				os.date("%H:%M:%S", call.timestamp),
				#call.arguments
			)
			
			for i, arg in ipairs(call.arguments) do
				content = content .. string.format("--   [%d] (%s) %s\n", i, type(arg), serializeArg(arg))
			end
			
			content = content .. "\n-- [HEX DUMP]:\n"
			local hexLines = string.split(call.hexDump, "\n")
			local offset = 0
			for _, hexLine in ipairs(hexLines) do
				if hexLine ~= "" then
					content = content .. string.format("-- %08X  %s\n", offset, hexLine)
					offset = offset + 16
				end
			end
			
			content = content .. "\nlocal Payload_" .. idx .. " = {\n"
			for i, arg in ipairs(call.arguments) do
				content = content .. string.format("    [%d] = %s,\n", i, serializeArg(arg))
			end
			content = content .. "}\n\n"
			content = content .. string.rep("─", 70) .. "\n\n"
		end
		
		local filePath = remoteDir .. "/" .. remoteName .. ".lua"
		local uniquePath = getUniquePath(filePath, ".lua")
		
		local ok = pcall(function()
			ensureDir(remoteDir)
			writefile(uniquePath, content)
		end)
		
		if ok then
			addLog(string.format("[SPY] %s (%d calls)", remoteName, invocations), Color3.fromRGB(100, 200, 255))
			totalWritten = totalWritten + 1
		end
		
		checkYield()
	end
	
	return totalWritten
end

local function hookRemoteCalls()
	addLog("🔌 Hooking RemoteEvent & RemoteFunction...", Color3.fromRGB(150, 150, 255))
	
	if hookfunction then
		pcall(function()
			local remoteEvent = Instance.new("RemoteEvent")
			if remoteEvent.FireServer then
				local oldFireServer
				oldFireServer = hookfunction(remoteEvent.FireServer, function(self, ...)
					local remoteName = self.Name or "UnknownRemote"
					local args = {...}
					captureRemoteCall(remoteName, "CLIENT → SERVER", "FireServer", args)
					return oldFireServer(self, ...)
				end)
			end
		end)
		
		pcall(function()
			local remoteFunc = Instance.new("RemoteFunction")
			if remoteFunc.InvokeServer then
				local oldInvokeServer
				oldInvokeServer = hookfunction(remoteFunc.InvokeServer, function(self, ...)
					local remoteName = self.Name or "UnknownRemote"
					local args = {...}
					captureRemoteCall(remoteName, "CLIENT → SERVER", "InvokeServer", args)
					return oldInvokeServer(self, ...)
				end)
			end
		end)
		
		addLog("[HOOK] RemoteEvent.FireServer + RemoteFunction.InvokeServer hooked", Color3.fromRGB(150, 200, 100))
	else
		addLog("[WARN] hookfunction not available - remote spy limited mode", Color3.fromRGB(255, 180, 80))
	end
end

local function runRemoteSpyPhase()
	setPhaseStatus("remote_spy", 0, 1)
	addLog("", Color3.fromRGB(40, 40, 40))
	addLog("╔══════════════════════════════════════╗", Color3.fromRGB(100, 180, 255))
	addLog("║  📡 PHASE 4: REMOTE SPY (TOOL 2)     ║", Color3.fromRGB(100, 180, 255))
	addLog("╚══════════════════════════════════════╝", Color3.fromRGB(100, 180, 255))
	
	setProgress("PHASE 4/4: Capturing remote traffic...")
	markPhaseActive("remote_spy")
	
	hookRemoteCalls()
	
	addLog("⏳ Listening for remote calls (5 seconds)...", Color3.fromRGB(180, 150, 100))
	for i = 5, 1, -1 do
		task.wait(1)
		addLog(string.format("   %ds remaining...", i), Color3.fromRGB(150, 150, 150))
	end
	
	local remotesWritten = writeRemoteSpyFiles()
	
	markPhaseDone("remote_spy", remotesWritten)
	addLog("", Color3.fromRGB(40, 40, 40))
end

