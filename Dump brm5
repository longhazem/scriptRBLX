local function ensureDir(path)
	if not isfolder(path) then
		pcall(makefolder, path)
	end
end

local function createFoldersForPath(fullPath)
	local parts = string.split(fullPath, "/")
	local current = parts[1]
	for i = 2, #parts - 1 do
		current = current .. "/" .. parts[i]
		ensureDir(current)
	end
end

local function getUniquePath(path, ext)
	if not isfile(path .. ext) then return path .. ext end
	local counter = 1
	while isfile(path .. "_" .. tostring(counter) .. ext) do
		counter += 1
	end
	return path .. "_" .. tostring(counter) .. ext
end

local function safeStr(s)
	s = tostring(s or "unknown")
	s = string.gsub(s, "[%c]", "")
	s = string.gsub(s, "[^%w%.%-%_]", "_")
	s = string.gsub(s, "^_+", "")
	if s == "" or s == "_" or s == ".lua" or s == ".luac" or s == ".luau" then
		s = "Script_" .. tostring(math.random(100000, 999999))
	end
	if #s > 100 then s = string.sub(s, 1, 100) end
	return s
end

local function logToFile(fileName, content)
	local current = ""
	pcall(function()
		if isfile(fileName) then current = readfile(fileName) or "" end
	end)
	pcall(writefile, fileName, current .. content .. "\n\n")
end

local function bcHash(bc)
	if not bc or #bc == 0 then return nil end
	return tostring(#bc) .. "_" .. string.sub(bc, 1, 64)
end

local function cleanSource(src)
	if not Config.CleanHeaders then return src end
	src = src:gsub("^%-%- Decompiled with[%s%S]-%\n%\n", "")
	src = src:gsub("^%-%- Decompiled by[%s%S]-%\n%\n",   "")
	src = src:gsub("^%-%- Decompiler[%s%S]-%\n%\n",      "")
	return src
end

local function isUselessSrc(src)
	if type(src) ~= "string" or #src == 0 then return true end
	local stripped = string.gsub(src, "%s+", "")
	if #stripped < 8 then return true end
	if #stripped < 200 then
		local lower = string.lower(stripped)
		if string.find(lower, "failed", 1, true)
			or string.find(lower, "unable", 1, true)
			or string.find(lower, "error", 1, true)
			or string.find(lower, "cannotdecompile", 1, true) then
			return true
		end
	end
	return false
end

local function unwrapProxy(obj)
	if obj == nil then return nil end
	local realObj = obj
	local ok, mt = pcall(getrawmetatable, obj)
	if ok and mt then
		local ok2, real = pcall(function()
			local indexFn = rawget(mt, "__index")
			if type(indexFn) == "function" then
				for i = 1, 30 do
					local n, v = debug.getupvalue(indexFn, i)
					if n == nil then break end
					if type(v) == "table" and v.GetObject then
						return v:GetObject()
					end
				end
			end
		end)
		if ok2 and real and real ~= obj then realObj = real end
	end
	return realObj
end

