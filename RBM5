local currentExecutor = identifyexecutor and identifyexecutor() or "Unknown"

local function calculateUNC()
	local coreFunctions = {hookfunction,hookmetatable,getgc,getreg,getgenv,getupvalues,checkclosure,isourclosure,newcclosure,setclipboard,getloadedmodules,getnilinstances}
	local passed = 0
	for _, func in pairs(coreFunctions) do if func then passed = passed + 1 end end
	return math.floor((passed / #coreFunctions) * 100)
end

