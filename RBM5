local function loadScript(url, platform)
	pcBtn.Active = false; mobileBtn.Active = false
	pcBtn.BackgroundColor3 = Color3.fromRGB(50,50,60)
	mobileBtn.BackgroundColor3 = Color3.fromRGB(50,50,60)
	loadingLabel.Text = "Đang tải "..platform.."..."

	task.wait(0.5)
	sg:Destroy()

	local ok, err = pcall(function()
		loadstring(game:HttpGet(url))()
	end)

	if not ok then
		warn("[Tokaihub Loader] Failed: " .. tostring(err))
	end
end

pcBtn.MouseButton1Click:Connect(function()
	loadScript(URL_PC, "PC")
end)

mobileBtn.MouseButton1Click:Connect(function()
