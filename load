local blockedExecutors = {["Solara"] = true, ["Xeno"] = true, ["Wave"] = true, ["Synapse Z"] = true, ["Opiumware"] = true, ["Vega x"] = true}
local currentExecutor = identifyexecutor and identifyexecutor() or "Unknown"

local function calculateUNC()
    local coreFunctions = {hookfunction, hookmetatable, getgc, getreg, getgenv, getupvalues, checkclosure, isourclosure, newcclosure, setclipboard, getloadedmodules, getnilinstances}
    local passed = 0
    for _, func in pairs(coreFunctions) do if func then passed = passed + 1 end end
    return math.floor((passed / #coreFunctions) * 100)
end

local userUNC = calculateUNC()
local isBlocked = false

for blockedName, _ in pairs(blockedExecutors) do
    if currentExecutor:lower():find(blockedName:lower()) then
        isBlocked = true
        break
    end
end

local sg = Instance.new("ScreenGui")
sg.Name = "BRM5_Loader_UI"
sg.ResetOnSpawn = false
pcall(function() sg.Parent = game:GetService("CoreGui") end)
if not sg.Parent then sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 360, 0, 240)
frame.Position = UDim2.new(0.5, -180, 0.5, -120)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = sg

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Thickness = 1.5
stroke.Color = isBlocked and Color3.fromRGB(220, 50, 50) or Color3.fromRGB(50, 150, 250)
stroke.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "SYSTEM COMPATIBILITY CHECK"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.BackgroundTransparency = 1
title.Parent = frame

local infoText = Instance.new("TextLabel")
infoText.Size = UDim2.new(1, -40, 0, 60)
infoText.Position = UDim2.new(0, 20, 0, 50)
infoText.Text = string.format("Executor: %s\nUNC Score: %d%%", currentExecutor, userUNC)
infoText.TextColor3 = Color3.fromRGB(200, 200, 200)
infoText.Font = Enum.Font.Gotham
infoText.TextSize = 14
infoText.TextXAlignment = Enum.TextXAlignment.Left
infoText.BackgroundTransparency = 1
infoText.Parent = frame

local statusText = Instance.new("TextLabel")
statusText.Size = UDim2.new(1, -40, 0, 40)
statusText.Position = UDim2.new(0, 20, 0, 115)
statusText.Font = Enum.Font.GothamBold
statusText.TextSize = 13
statusText.BackgroundTransparency = 1
statusText.Parent = frame

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, -40, 0, 40)
btn.Position = UDim2.new(0, 20, 0, 175)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.BorderSizePixel = 0
btn.Parent = frame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 6)
btnCorner.Parent = btn

if isBlocked or userUNC < 70 then
    statusText.Text = "Status: The executor is not supported."
    statusText.TextColor3 = Color3.fromRGB(240, 70, 70)
    
    btn.Text = "Support Discord (Copy Link)"
    btn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    
    btn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard("https://discord.gg/deVVQEVybd")
            btn.Text = "Copied to Clipboard!"
            task.wait(2)
            btn.Text = "Support Discord (Copy Link)"
        else
            btn.Text = "Error: setclipboard not supported"
        end
    end)
    return
else
    statusText.Text = "Status: Compatibility Passed! Loading script..."
    statusText.TextColor3 = Color3.fromRGB(70, 240, 70)
    
    btn.Text = "Close Loader"
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    
    btn.MouseButton1Click:Connect(function()
        sg:Destroy()
    end)
end

task.wait(1.5)
sg:Destroy()

local success, result = pcall(function()
    return loadstring(game:HttpGet("https://githubusercontent.com"))()
end)

if not success then
    warn("[BRM5 Loader Error]: Failed to load the main script. Error: " .. tostring(result))
end
