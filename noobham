-- ── NPC FOLDER CHECK (copy từ script gốc hoạt động) ────────
local function isNoobFolder(instance)
    if not instance:IsA("Folder") then return false end
    local name = instance.Name:lower()
    return name == "allnoobs" or name:find("noob", 1, true) ~= nil
end

-- ── KILL ALL NOOBS (copy y chang script gốc) ────────────────
local function killNoobs()
    for _, object in ipairs(workspace:GetDescendants()) do
        if isNoobFolder(object) then
            for _, descendant in ipairs(object:GetDescendants()) do
                if descendant:IsA("Humanoid") then
                    descendant.Health = 0
                end
            end
        end
    end
end

-- ── GET NOOB MODELS (cho ESP/counter) ───────────────────────
local function getNoobModels()
    local out, seen = {}, {}
    for _, object in ipairs(workspace:GetDescendants()) do
        if isNoobFolder(object) then
            for _, desc in ipairs(object:GetDescendants()) do
                if desc:IsA("Humanoid") and desc.Health > 0 then
                    local model = desc.Parent
                    if model and not seen[model] then
                        seen[model] = true
                        table.insert(out, {model = model, hum = desc})
                    end
                end
            end
        end
    end
    return out
end

-- ── STATE ───────────────────────────────────────────────────
local auraEnabled   = false
local auraRadius    = 5000
local auraUseRadius = false

local espEnabled  = false
local espNPCColor = Color3.fromRGB(255, 165, 0)
local espPLRColor = Color3.fromRGB(255, 50, 50)
local espMaxDist  = 500
local espBoxes    = true
local espNames    = true
local espHealth   = true
local espDist     = true
local espObjects  = {}

local chamsEnabled  = false
local chamsColor    = Color3.fromRGB(255, 110, 180)
local chamsMat      = Enum.Material.Neon
local chamsStore    = {}

local wspeedOn  = false
local wspeedVal = 16
local jPowerOn  = false
local jPowerVal = 50

-- ── UTIL ────────────────────────────────────────────────────
local function getChar(p) return p and p.Character end
local function getHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot(c)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function myPos()
    local r = getRoot(getChar(LocalPlayer))
    return r and r.Position
end
local function distFromMe(root)
    local mp = myPos()
    if not mp or not root then return 0 end
    return (mp - root.Position).Magnitude
end

-- ── KILL LOOP — đúng pattern script gốc ─────────────────────
task.spawn(function()
    while true do
        if auraEnabled then
            if auraUseRadius then
                -- Chỉ kill trong radius
                for _, object in ipairs(workspace:GetDescendants()) do
                    if isNoobFolder(object) then
                        for _, desc in ipairs(object:GetDescendants()) do
                            if desc:IsA("Humanoid") and desc.Health > 0 then
                                local root = getRoot(desc.Parent)
                                if root and distFromMe(root) <= auraRadius then
                                    desc.Health = 0
                                end
                            end
                        end
                    end
                end
            else
                -- Kill toàn map — y chang script gốc
                killNoobs()
            end
        end
        task.wait(0.15)
    end
end)

-- ── ESP ─────────────────────────────────────────────────────
local function removeESP(key)
    local e = espObjects[key]
    if not e then return end
    pcall(function()
        if e.bb  and e.bb.Parent  then e.bb:Destroy()  end
        if e.sel and e.sel.Parent then e.sel:Destroy() end
    end)
    espObjects[key] = nil
end

local function buildESP(key, color)
    local bb = Instance.new("BillboardGui")
    bb.Name        = "MTCESP"
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 220, 0, 52)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.ResetOnSpawn = false

    local nameL = Instance.new("TextLabel")
    nameL.Size = UDim2.new(1,0,0.5,0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3 = color
    nameL.TextStrokeTransparency = 0
    nameL.Font = Enum.Font.GothamBold
    nameL.TextScaled = true
    nameL.Text = ""
    nameL.Parent = bb

    local hpL = Instance.new("TextLabel")
    hpL.Size = UDim2.new(1,0,0.5,0)
    hpL.Position = UDim2.new(0,0,0.5,0)
    hpL.BackgroundTransparency = 1
    hpL.TextStrokeTransparency = 0
    hpL.Font = Enum.Font.Gotham
    hpL.TextScaled = true
    hpL.Text = ""
    hpL.Parent = bb

    local sel = Instance.new("SelectionBox")
    sel.Color3 = color
    sel.LineThickness = 0.05
    sel.SurfaceTransparency = 1
    sel.SurfaceColor3 = color

    espObjects[key] = {bb=bb, nameL=nameL, hpL=hpL, sel=sel}
end

local function processESP(model, hum, key, color, label)
    if not model or not hum then return end
    local root = getRoot(model)
    if not root then return end
    if distFromMe(root) > espMaxDist then removeESP(key) return end

    if not espObjects[key] then buildESP(key, color) end
    local e = espObjects[key]
    if not e then return end

    if e.bb.Parent ~= root   then e.bb.Parent   = root  end
    if e.sel.Adornee ~= model then
        e.sel.Adornee = model
        e.sel.Parent  = model
    end

    e.sel.Visible = espBoxes
    e.sel.Color3  = color
    e.nameL.TextColor3 = color

    local txt = ""
    if espNames then txt = label end
    if espDist  then txt = txt .. string.format(" [%.0f]", distFromMe(root)) end
    e.nameL.Text    = txt
    e.nameL.Visible = espNames or espDist

    if espHealth and hum.MaxHealth > 0 then
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        e.hpL.Text = string.format("HP: %.0f/%.0f", hum.Health, hum.MaxHealth)
        e.hpL.TextColor3 = Color3.fromRGB(
            math.floor((1-ratio)*255), math.floor(ratio*255), 0)
        e.hpL.Visible = true
    else
        e.hpL.Visible = false
    end
end

local function updateESP()
    if not espEnabled then
        for k in pairs(espObjects) do removeESP(k) end
        return
    end

    local visited = {}

    -- NPC
    for _, entry in ipairs(getNoobModels()) do
        local key = "npc_" .. entry.model:GetDebugId()
        processESP(entry.model, entry.hum, key, espNPCColor, entry.model.Name)
        visited[key] = true
    end

    -- Players
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        local h = getHum(c)
        if not c or not h or h.Health <= 0 then
            removeESP("plr_"..p.UserId)
            continue
        end
        local key = "plr_"..p.UserId
        processESP(c, h, key, espPLRColor, p.Name)
        visited[key] = true
    end

    for k in pairs(espObjects) do
        if not visited[k] then removeESP(k) end
    end
end

-- ── CHAMS ───────────────────────────────────────────────────
local MAT = {
    Neon=Enum.Material.Neon, Glass=Enum.Material.Glass,
    Foil=Enum.Material.Foil, SmoothPlastic=Enum.Material.SmoothPlastic,
}

local function applyChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            if not chamsStore[p] then
                chamsStore[p] = {mat=p.Material, col=p.Color}
            end
            p.Material = chamsMat
            p.Color    = chamsColor
        end
    end
end

local function revertChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            local s = chamsStore[p]
            if s then p.Material=s.mat p.Color=s.col chamsStore[p]=nil end
        end
    end
end

local function updateChams()
    for _, entry in ipairs(getNoobModels()) do
        if chamsEnabled then applyChams(entry.model) else revertChams(entry.model) end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if not c then continue end
        if chamsEnabled then applyChams(c) else revertChams(c) end
    end
end

-- ── MOVEMENT ────────────────────────────────────────────────
local function applySpeed()
    local h = getHum(getChar(LocalPlayer))
    if h then h.WalkSpeed = wspeedOn and wspeedVal or 16 end
end
local function applyJump()
    local h = getHum(getChar(LocalPlayer))
    if h then h.JumpPower = jPowerOn and jPowerVal or 50 end
end

