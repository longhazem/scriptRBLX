local LocalPlayer = Players.LocalPlayer

-- ── NPC CHECK ───────────────────────────────────────────────
-- NPC = Model có Humanoid, không phải character của player nào
local playerChars = {}
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(c) playerChars[c] = true end)
    p.CharacterRemoving:Connect(function(c) playerChars[c] = nil end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    if p.Character then playerChars[p.Character] = true end
    p.CharacterAdded:Connect(function(c) playerChars[c] = true end)
    p.CharacterRemoving:Connect(function(c) playerChars[c] = nil end)
end

local function isNPC(model)
    if not model:IsA("Model") then return false end
    if playerChars[model] then return false end
    if model == LocalPlayer.Character then return false end
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- ── GET NPCs ────────────────────────────────────────────────
local function getNPCs()
    local out = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                table.insert(out, {model = obj, hum = hum})
            end
        end
    end
    return out
end

-- Kill tất cả NPC
local function killAllNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end
    end
end

-- ── STATE ───────────────────────────────────────────────────
local auraEnabled   = false
local auraRadius    = 5000
local auraUseRadius = false

local espEnabled  = false
local espNPCColor = Color3.fromRGB(255, 165, 0)
local espPLRColor = Color3.fromRGB(255, 50, 50)
local espMaxDist  = 500
local espBoxes    = true
local espNames    = true
local espHealth   = true
local espDist     = true
local espObjects  = {}

local chamsEnabled = false
local chamsColor   = Color3.fromRGB(255, 110, 180)
local chamsMat     = Enum.Material.Neon
local chamsStore   = {}

local wspeedOn  = false  local wspeedVal = 16
local jPowerOn  = false  local jPowerVal = 50

-- ── UTIL ────────────────────────────────────────────────────
local function getChar(p) return p and p.Character end
local function getHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot(c)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function myPos()
    local r = getRoot(getChar(LocalPlayer))
    return r and r.Position
end
local function distFromMe(pos)
    local mp = myPos()
    if not mp then return 0 end
    return (mp - pos).Magnitude
end

-- ── KILL LOOP ───────────────────────────────────────────────
task.spawn(function()
    while true do
        if auraEnabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isNPC(obj) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if auraUseRadius then
                            local root = getRoot(obj)
                            if root and distFromMe(root.Position) <= auraRadius then
                                hum.Health = 0
                            end
                        else
                            hum.Health = 0
                        end
                    end
                end
            end
        end
        task.wait(0.15)
    end
end)

-- ── ESP ─────────────────────────────────────────────────────
local function removeESP(key)
    local e = espObjects[key]
    if not e then return end
    pcall(function() e.bb:Destroy()  end)
    pcall(function() e.sel:Destroy() end)
    espObjects[key] = nil
end

local function buildESP(key, color)
    -- BillboardGui attach vào Adornee trực tiếp, không cần parent vào part
    local bb = Instance.new("BillboardGui")
    bb.Name              = "MTCESP"
    bb.AlwaysOnTop       = true
    bb.Size              = UDim2.new(6, 0, 1.5, 0)  -- SizeOffset.X tính bằng studs
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.ResetOnSpawn      = false
    bb.ClipsDescendants  = false
    bb.LightInfluence    = 0

    local nameL = Instance.new("TextLabel")
    nameL.Name                   = "NameL"
    nameL.Size                   = UDim2.new(1, 0, 0.55, 0)
    nameL.Position               = UDim2.new(0, 0, 0, 0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3             = color
    nameL.TextStrokeTransparency = 0
    nameL.TextStrokeColor3       = Color3.new(0, 0, 0)
    nameL.Font                   = Enum.Font.GothamBold
    nameL.TextSize               = 14   -- fixed size, không dùng TextScaled
    nameL.Text                   = ""
    nameL.Parent                 = bb

    local hpL = Instance.new("TextLabel")
    hpL.Name                   = "HpL"
    hpL.Size                   = UDim2.new(1, 0, 0.45, 0)
    hpL.Position               = UDim2.new(0, 0, 0.55, 0)
    hpL.BackgroundTransparency = 1
    hpL.TextColor3             = Color3.fromRGB(80, 255, 80)
    hpL.TextStrokeTransparency = 0
    hpL.TextStrokeColor3       = Color3.new(0, 0, 0)
    hpL.Font                   = Enum.Font.Gotham
    hpL.TextSize               = 12
    hpL.Text                   = ""
    hpL.Parent                 = bb

    local sel = Instance.new("SelectionBox")
    sel.Color3              = color
    sel.LineThickness       = 0.06
    sel.SurfaceTransparency = 1
    sel.SurfaceColor3       = color

    espObjects[key] = {bb = bb, nameL = nameL, hpL = hpL, sel = sel}
end

local function processESP(model, hum, key, color, label)
    if not model or not hum or hum.Health <= 0 then
        removeESP(key)
        return false
    end
    local root = getRoot(model)
    if not root then removeESP(key) return false end

    local d = distFromMe(root.Position)
    if d > espMaxDist then removeESP(key) return false end

    if not espObjects[key] then buildESP(key, color) end
    local e = espObjects[key]
    if not e then return false end

    -- Adornee = root part, parent = CoreGui hoặc PlayerGui để không bị destroy
    if e.bb.Adornee ~= root then
        e.bb.Adornee = root
        e.bb.Parent  = LocalPlayer.PlayerGui
    end

    -- SelectionBox bao model
    if e.sel.Adornee ~= model then
        e.sel.Adornee = model
        e.sel.Parent  = workspace
    end

    e.sel.Visible       = espBoxes
    e.sel.Color3        = color
    e.sel.SurfaceColor3 = color
    e.nameL.TextColor3  = color

    -- Name + distance
    local txt = ""
    if espNames then txt = label end
    if espDist  then txt = txt .. string.format(" [%.0f]", d) end
    e.nameL.Text    = txt
    e.nameL.Visible = espNames or espDist

    -- HP
    if espHealth and hum.MaxHealth > 0 then
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        e.hpL.Text       = string.format("HP %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
        e.hpL.TextColor3 = Color3.fromRGB(math.floor((1-ratio)*255), math.floor(ratio*255), 0)
        e.hpL.Visible    = true
    else
        e.hpL.Visible = false
    end

    return true
end

local function updateESP()
    if not espEnabled then
        for k in pairs(espObjects) do removeESP(k) end
        return
    end

    local visited = {}

    -- NPC ESP
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum then
                local key = "npc_" .. obj:GetDebugId()
                if processESP(obj, hum, key, espNPCColor, obj.Name) then
                    visited[key] = true
                end
            end
        end
    end

    -- Player ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c   = getChar(p)
        local hum = getHum(c)
        local key = "plr_" .. p.UserId
        if processESP(c, hum, key, espPLRColor, p.Name) then
            visited[key] = true
        end
    end

    -- Cleanup
    for k in pairs(espObjects) do
        if not visited[k] then removeESP(k) end
    end
end

-- ── CHAMS ───────────────────────────────────────────────────
local MAT = {
    Neon=Enum.Material.Neon, Glass=Enum.Material.Glass,
    Foil=Enum.Material.Foil, SmoothPlastic=Enum.Material.SmoothPlastic,
}

local function applyChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            if not chamsStore[p] then
                chamsStore[p] = {mat=p.Material, col=p.Color}
            end
            p.Material = chamsMat
            p.Color    = chamsColor
        end
    end
end

local function revertChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            local s = chamsStore[p]
            if s then
                p.Material = s.mat
                p.Color    = s.col
                chamsStore[p] = nil
            end
        end
    end
end

local function updateChams()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then
            if chamsEnabled then applyChams(obj) else revertChams(obj) end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if c then
            if chamsEnabled then applyChams(c) else revertChams(c) end
        end
    end
end

-- ── MOVEMENT ────────────────────────────────────────────────
local function applySpeed()
    local h = getHum(getChar(LocalPlayer))
    if h then h.WalkSpeed = wspeedOn and wspeedVal or 16 end
end
local function applyJump()
    local h = getHum(getChar(LocalPlayer))
    if h then h.JumpPower = jPowerOn and jPowerVal or 50 end
end

