-- ── NPC SCAN — mirrors confirmed working script ─
-- Folders named "allnoobs" or containing "noob" hold the NPCs
local function isNoobFolder(obj)
    if not obj:IsA("Folder") then return false end
    local n = obj.Name:lower()
    return n == "allnoobs" or n:find("noob", 1, true) ~= nil
end

-- Returns all live Humanoids from noob folders
local function getNoobHumanoids()
    local out = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNoobFolder(obj) then
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("Humanoid") and desc.Health > 0 then
                    table.insert(out, desc)
                end
            end
        end
    end
    return out
end

-- Returns all live Noob Models (Humanoid parent = the model)
local function getNoobModels()
    local out = {}
    local seen = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNoobFolder(obj) then
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("Humanoid") and desc.Health > 0 then
                    local model = desc.Parent
                    if model and not seen[model] then
                        seen[model] = true
                        table.insert(out, {model = model, hum = desc})
                    end
                end
            end
        end
    end
    return out
end

-- ── STATE ───────────────────────────────────────
local State = {
    -- Kill Aura
    auraEnabled  = false,
    auraRadius   = 5000,
    auraUseRadius = false,
    auraInterval = 0.15,

    -- ESP
    espEnabled  = false,
    espNPCColor = Color3.fromRGB(255, 165, 0),
    espPLRColor = Color3.fromRGB(255, 50, 50),
    espMaxDist  = 500,
    espBoxes    = true,
    espNames    = true,
    espHealth   = true,
    espDistance = true,
    espObjects  = {},      -- key → {billboard, highlight}

    -- Chams
    chamsEnabled  = false,
    chamsColor    = Color3.fromRGB(255, 110, 180),
    chamsMaterial = Enum.Material.Neon,
    chamsStore    = {},

    -- Movement
    wspeedOn  = false, wspeedVal = 16,
    jPowerOn  = false, jPowerVal = 50,

    -- World
    origBright  = Lighting.Brightness,
    origShadows = Lighting.GlobalShadows,
}

-- ── UTIL ────────────────────────────────────────
local function getChar(p) return p and p.Character end
local function getHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end

local function myPos()
    local c = getChar(LocalPlayer)
    local r = c and getRoot(c)
    return r and r.Position
end

local function distFromMe(root)
    local mp = myPos()
    if not mp or not root then return 0 end
    return (mp - root.Position).Magnitude
end

-- ── KILL AURA ───────────────────────────────────
-- Mirrors the confirmed-working reference script loop exactly.
-- No interval throttle — Heartbeat fires every frame but Health=0
-- write is idempotent so frequency doesn't matter.
local function killAuraTick()
    if not State.auraEnabled then return end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNoobFolder(obj) then
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("Humanoid") and desc.Health > 0 then
                    if State.auraUseRadius then
                        local root = getRoot(desc.Parent)
                        if root and distFromMe(root) > State.auraRadius then continue end
                    end
                    desc.Health = 0
                end
            end
        end
    end
end

-- ── ESP ─────────────────────────────────────────
local function removeESP(key)
    local e = State.espObjects[key]
    if not e then return end
    pcall(function()
        if e.bb  and e.bb.Parent  then e.bb:Destroy()  end
        if e.sel and e.sel.Parent then e.sel:Destroy() end
    end)
    State.espObjects[key] = nil
end

local function buildESP(key, color)
    local bb = Instance.new("BillboardGui")
    bb.Name          = "MTCESP"
    bb.AlwaysOnTop   = true
    bb.Size          = UDim2.new(0, 220, 0, 52)
    bb.StudsOffset   = Vector3.new(0, 3.5, 0)
    bb.ResetOnSpawn  = false

    local nameL = Instance.new("TextLabel")
    nameL.Size                   = UDim2.new(1,0,0.5,0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3             = color
    nameL.TextStrokeTransparency = 0
    nameL.Font                   = Enum.Font.GothamBold
    nameL.TextScaled             = true
    nameL.Text                   = ""
    nameL.Parent                 = bb

    local hpL = Instance.new("TextLabel")
    hpL.Size                   = UDim2.new(1,0,0.5,0)
    hpL.Position               = UDim2.new(0,0,0.5,0)
    hpL.BackgroundTransparency = 1
    hpL.TextStrokeTransparency = 0
    hpL.Font                   = Enum.Font.Gotham
    hpL.TextScaled             = true
    hpL.Text                   = ""
    hpL.Parent                 = bb

    local sel = Instance.new("SelectionBox")
    sel.Color3              = color
    sel.LineThickness       = 0.05
    sel.SurfaceTransparency = 1
    sel.SurfaceColor3       = color

    State.espObjects[key] = {bb = bb, nameL = nameL, hpL = hpL, sel = sel}
end

local function updateESP()
    if not State.espEnabled then
        for k in pairs(State.espObjects) do removeESP(k) end
        return
    end

    local visited = {}

    local function processModel(model, hum, key, color, label)
        if not model or not hum then return end
        local root = getRoot(model)
        if not root then return end
        local d = distFromMe(root)
        if d > State.espMaxDist then removeESP(key) return end

        visited[key] = true

        if not State.espObjects[key] then buildESP(key, color) end
        local e = State.espObjects[key]
        if not e then return end

        if e.bb.Parent ~= root then e.bb.Parent = root end
        if e.sel.Adornee ~= model then
            e.sel.Adornee = model
            e.sel.Parent  = model
        end

        e.sel.Visible  = State.espBoxes
        e.sel.Color3   = color
        e.nameL.TextColor3 = color

        local nameText = ""
        if State.espNames    then nameText = label end
        if State.espDistance then nameText = nameText .. string.format(" [%.0f]", d) end
        e.nameL.Text    = nameText
        e.nameL.Visible = State.espNames or State.espDistance

        if State.espHealth and hum.MaxHealth > 0 then
            local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            e.hpL.Text = string.format("HP: %.0f/%.0f", hum.Health, hum.MaxHealth)
            e.hpL.TextColor3 = Color3.fromRGB(
                math.floor((1-ratio)*255), math.floor(ratio*255), 0)
            e.hpL.Visible = true
        else
            e.hpL.Visible = false
        end
    end

    -- NPC ESP — folder-based scan (matches confirmed structure)
    for _, entry in ipairs(getNoobModels()) do
        local key = "npc_" .. entry.model:GetDebugId()
        processModel(entry.model, entry.hum, key, State.espNPCColor, entry.model.Name)
    end

    -- Player ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        local h = getHum(c)
        if not c or not h or h.Health <= 0 then
            removeESP("plr_" .. p.UserId)
            continue
        end
        local key = "plr_" .. p.UserId
        processModel(c, h, key, State.espPLRColor, p.Name)
    end

    -- Cleanup
    for k in pairs(State.espObjects) do
        if not visited[k] then removeESP(k) end
    end
end

-- ── CHAMS ───────────────────────────────────────
local MAT = {
    Neon=Enum.Material.Neon, Glass=Enum.Material.Glass,
    Foil=Enum.Material.Foil, SmoothPlastic=Enum.Material.SmoothPlastic,
}

local function applyChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            if not State.chamsStore[p] then
                State.chamsStore[p] = {mat=p.Material, col=p.Color}
            end
            p.Material = State.chamsMaterial
            p.Color    = State.chamsColor
        end
    end
end

local function revertChams(model)
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            local s = State.chamsStore[p]
            if s then p.Material=s.mat p.Color=s.col State.chamsStore[p]=nil end
        end
    end
end

local function updateChams()
    for _, entry in ipairs(getNoobModels()) do
        if State.chamsEnabled then applyChams(entry.model) else revertChams(entry.model) end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if not c then continue end
        if State.chamsEnabled then applyChams(c) else revertChams(c) end
    end
end

-- ── MOVEMENT ────────────────────────────────────
local function applySpeed()
    local h = getHum(getChar(LocalPlayer))
    if h then h.WalkSpeed = State.wspeedOn and State.wspeedVal or 16 end
end
local function applyJump()
    local h = getHum(getChar(LocalPlayer))
    if h then h.JumpPower = State.jPowerOn and State.jPowerVal or 50 end
end

