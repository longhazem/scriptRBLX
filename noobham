-- ── UTILITY ─────────────────────────────────────
local function getChar(p) return p and p.Character end
local function getRoot(c) return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end
local function getHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function myRoot()
    local c = getChar(LocalPlayer)
    return c and getRoot(c)
end

local function distBetween(a, b)
    -- a, b = BasePart
    if not a or not b then return math.huge end
    return (a.Position - b.Position).Magnitude
end

-- ── NPC DETECTION ───────────────────────────────
-- Returns true if model is an enemy NPC (not a player character)
local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    -- Must have Humanoid
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    -- Must NOT be a player character
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then return false end
    end
    -- Name match against known NPC patterns
    for _, pattern in ipairs(NPC_PATTERNS) do
        if model.Name:find(pattern) then return true end
    end
    -- Fallback: any model with Humanoid not belonging to a player
    return true
end

local function isNPCAlive(model)
    local h = getHum(model)
    return h and h.Health > 0
end

-- ── TARGET SYSTEM ───────────────────────────────
-- Returns list of {model, dist, root, isNPC} sorted by priority
local function getAllTargets()
    local mr = myRoot()
    if not mr then return {} end

    local out = {}

    -- Enemy players
    if State.auraTargetPlayer then
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            if State.auraTeam and LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team then continue end
            local c = getChar(p)
            if not c then continue end
            local h = getHum(c)
            if not h or h.Health <= 0 then continue end
            local tr = getRoot(c)
            if not tr then continue end
            local d = distBetween(mr, tr)
            if d <= State.auraRadius then
                table.insert(out, {model = c, dist = d, root = tr, npc = false, hum = h, name = p.Name})
            end
        end
    end

    -- Workspace NPCs (RegNoob, InsertNoob, sentry etc.)
    if State.auraTargetNPC then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and isNPC(obj) and isNPCAlive(obj) then
                local h  = getHum(obj)
                local tr = getRoot(obj)
                if not tr then continue end
                local d = distBetween(mr, tr)
                if d <= State.auraRadius then
                    table.insert(out, {model = obj, dist = d, root = tr, npc = true, hum = h, name = obj.Name})
                end
            end
        end
    end

    -- Sort
    if State.auraPriority == "Nearest" then
        table.sort(out, function(a, b) return a.dist < b.dist end)
    elseif State.auraPriority == "Lowest HP" then
        table.sort(out, function(a, b)
            return (a.hum and a.hum.Health or math.huge) < (b.hum and b.hum.Health or math.huge)
        end)
    elseif State.auraPriority == "Highest HP" then
        table.sort(out, function(a, b)
            return (a.hum and a.hum.Health or 0) > (b.hum and b.hum.Health or 0)
        end)
    elseif State.auraPriority == "Furthest" then
        table.sort(out, function(a, b) return a.dist > b.dist end)
    end

    return out
end

-- ── TOOL UTILS ──────────────────────────────────
local function getEquippedTool()
    local c = getChar(LocalPlayer)
    if not c then return nil end
    for _, name in ipairs(TOOL_PRIORITY) do
        local t = c:FindFirstChild(name)
        if t and t:IsA("Tool") then return t end
    end
    for _, obj in ipairs(c:GetChildren()) do
        if obj:IsA("Tool") then return obj end
    end
end

local function ensureTool()
    local t = getEquippedTool()
    if t then return t end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, name in ipairs(TOOL_PRIORITY) do
        local tool = bp:FindFirstChild(name)
        if tool then
            local c = getChar(LocalPlayer)
            local h = getHum(c)
            if h then h:EquipTool(tool) end
            task.wait(0.05)
            return getEquippedTool()
        end
    end
end

local function faceTarget(targetRoot)
    local mr = myRoot()
    if not mr or not targetRoot then return end
    local dir = Vector3.new(
        targetRoot.Position.X - mr.Position.X,
        0,
        targetRoot.Position.Z - mr.Position.Z
    ).Unit
    mr.CFrame = CFrame.new(mr.Position, mr.Position + dir)
end

local function swingTool(tool)
    -- Try RemoteEvent first (game uses RS.Remotes.weapons pipeline)
    local weaponsRemote = game:GetService("ReplicatedStorage")
        :FindFirstChild("Remotes")
        and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("weapons")

    if weaponsRemote and weaponsRemote:IsA("RemoteEvent") then
        -- Fire with target info if possible
        weaponsRemote:FireServer()
    end

    -- Also activate via tool (Local_Wep_Handler picks this up)
    local remote = tool:FindFirstChild("Activate")
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer()
    else
        tool:Activate()
    end
end

-- ── KILL AURA TICK ──────────────────────────────
local function killAuraTick()
    if not State.auraEnabled then return end
    local now = tick()
    if now - State.lastSwing < State.auraInterval then return end

    local mc = getChar(LocalPlayer)
    if not mc then return end
    local mh = getHum(mc)
    if not mh or mh.Health <= 0 then return end

    local targets = getAllTargets()
    if #targets == 0 then return end

    local tool = ensureTool()
    if not tool then return end

    local target = targets[1]
    if State.auraFace then faceTarget(target.root) end
    swingTool(tool)
    State.lastSwing = now
end

-- ── ESP ─────────────────────────────────────────
local function removeESP(key)
    local e = State.espObjects[key]
    if not e then return end
    pcall(function()
        if e.billboard and e.billboard.Parent then e.billboard:Destroy() end
        if e.highlight  and e.highlight.Parent  then e.highlight:Destroy()  end
    end)
    State.espObjects[key] = nil
end

local function buildESP(key, isNPCTarget)
    if State.espObjects[key] then return end

    local bb = Instance.new("BillboardGui")
    bb.Name           = "MTC_ESP"
    bb.AlwaysOnTop    = true
    bb.Size           = UDim2.new(0, 220, 0, 55)
    bb.StudsOffset    = Vector3.new(0, 3.5, 0)
    bb.ResetOnSpawn   = false

    local nameL = Instance.new("TextLabel")
    nameL.Size                   = UDim2.new(1, 0, 0.5, 0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3             = isNPCTarget and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 255)
    nameL.TextStrokeTransparency = 0
    nameL.Font                   = Enum.Font.GothamBold
    nameL.TextScaled             = true
    nameL.Text                   = ""
    nameL.Parent                 = bb

    local hpL = Instance.new("TextLabel")
    hpL.Size                   = UDim2.new(1, 0, 0.5, 0)
    hpL.Position               = UDim2.new(0, 0, 0.5, 0)
    hpL.BackgroundTransparency = 1
    hpL.TextStrokeTransparency = 0
    hpL.Font                   = Enum.Font.Gotham
    hpL.TextScaled             = true
    hpL.Text                   = ""
    hpL.Parent                 = bb

    local hl = Instance.new("SelectionBox")
    hl.Color3              = isNPCTarget and State.espNPCColor or State.espBoxColor
    hl.LineThickness       = 0.05
    hl.SurfaceTransparency = 1
    hl.SurfaceColor3       = isNPCTarget and State.espNPCColor or State.espBoxColor

    State.espObjects[key] = {
        billboard = bb,
        nameLabel = nameL,
        hpLabel   = hpL,
        highlight = hl,
        isNPC     = isNPCTarget,
    }
end

local function updateESP()
    if not State.espEnabled then
        for key in pairs(State.espObjects) do removeESP(key) end
        return
    end

    local mr      = myRoot()
    local visited = {}

    -- Helper to update one model
    local function processModel(model, key, isNPCTarget)
        local h  = getHum(model)
        local tr = getRoot(model)
        if not h or not tr then removeESP(key) return end

        local d = mr and distBetween(mr, tr) or math.huge
        if d > State.espMaxDist then removeESP(key) return end

        visited[key] = true
        if not State.espObjects[key] then buildESP(key, isNPCTarget) end
        local e = State.espObjects[key]
        if not e then return end

        -- Attach billboard
        if e.billboard.Parent ~= tr then e.billboard.Parent = tr end

        -- Attach highlight
        if e.highlight.Adornee ~= model then
            e.highlight.Adornee = model
            e.highlight.Parent  = model
        end

        e.highlight.Visible = State.espBoxes

        -- Name
        local nameText = ""
        if State.espNames then nameText = model.Name end
        if State.espDistance then nameText = nameText .. string.format(" [%.0f]", d) end
        e.nameLabel.Text    = nameText
        e.nameLabel.Visible = State.espNames or State.espDistance

        -- HP
        if State.espHealth then
            local hp    = math.floor(h.Health)
            local maxhp = math.max(math.floor(h.MaxHealth), 1)
            local ratio = math.clamp(h.Health / maxhp, 0, 1)
            e.hpLabel.Text      = string.format("HP: %d/%d", hp, maxhp)
            e.hpLabel.TextColor3 = Color3.fromRGB(
                math.floor((1 - ratio) * 255),
                math.floor(ratio * 255),
                0
            )
            e.hpLabel.Visible = true
        else
            e.hpLabel.Visible = false
        end

        -- Color sync
        local col = isNPCTarget and State.espNPCColor or State.espBoxColor
        e.highlight.Color3    = col
        e.nameLabel.TextColor3 = isNPCTarget and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 255)
    end

    -- Player ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if not c then continue end
        local key = "player_" .. p.UserId
        processModel(c, key, false)
    end

    -- NPC ESP — scan workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isNPC(obj) then
            local key = "npc_" .. obj:GetDebugId()
            processModel(obj, key, true)
        end
    end

    -- Cleanup stale entries
    for key in pairs(State.espObjects) do
        if not visited[key] then removeESP(key) end
    end
end

-- ── CHAMS ───────────────────────────────────────
local MATERIAL_MAP = {
    Neon = Enum.Material.Neon, Glass = Enum.Material.Glass,
    Foil = Enum.Material.Foil, SmoothPlastic = Enum.Material.SmoothPlastic,
}

local function applyChams(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not State.chamsObjects[part] then
                State.chamsObjects[part] = {mat = part.Material, col = part.Color}
            end
            part.Material = State.chamsMaterial
            part.Color    = State.chamsColor
        end
    end
end

local function removeChams(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local orig = State.chamsObjects[part]
            if orig then
                part.Material = orig.mat
                part.Color    = orig.col
                State.chamsObjects[part] = nil
            end
        end
    end
end

local function updateChams()
    -- Players
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if not c then continue end
        if State.chamsEnabled then applyChams(c) else removeChams(c) end
    end
    -- NPCs
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isNPC(obj) then
            if State.chamsEnabled then applyChams(obj) else removeChams(obj) end
        end
    end
end

