-- ── UTILITY ─────────────────────────────────────
local function getChar(p)  return p and p.Character end
local function getRoot(c)  return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")) end
local function getHum(c)   return c and c:FindFirstChildOfClass("Humanoid") end

local function isAlive(p)
    local c = getChar(p)
    if not c then return false end
    local h = getHum(c)
    return h and h.Health > 0
end

local function sameTeam(p)
    if not State.auraTeam then return false end
    return LocalPlayer.Team ~= nil and p.Team == LocalPlayer.Team
end

local function distTo(p)
    local mc = getChar(LocalPlayer)
    local tc = getChar(p)
    if not mc or not tc then return math.huge end
    local mr = getRoot(mc)
    local tr = getRoot(tc)
    if not mr or not tr then return math.huge end
    return (mr.Position - tr.Position).Magnitude
end

-- ── TOOL UTILS ──────────────────────────────────
local TOOL_PRIORITY = {"Classic_Sword", "Classic_Slingshot"}

local function getEquippedTool()
    local c = getChar(LocalPlayer)
    if not c then return nil end
    for _, name in ipairs(TOOL_PRIORITY) do
        local t = c:FindFirstChild(name)
        if t and t:IsA("Tool") then return t end
    end
    for _, obj in ipairs(c:GetChildren()) do
        if obj:IsA("Tool") then return obj end
    end
end

local function ensureTool()
    local t = getEquippedTool()
    if t then return t end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return nil end
    for _, name in ipairs(TOOL_PRIORITY) do
        local tool = bp:FindFirstChild(name)
        if tool then
            local c = getChar(LocalPlayer)
            local h = getHum(c)
            if h then h:EquipTool(tool) end
            task.wait(0.05)
            return getEquippedTool()
        end
    end
end

local function faceTarget(targetRoot)
    local mc = getChar(LocalPlayer)
    if not mc then return end
    local mr = getRoot(mc)
    if not mr then return end
    local dir = (targetRoot.Position - mr.Position)
    dir = Vector3.new(dir.X, 0, dir.Z).Unit
    mr.CFrame = CFrame.new(mr.Position, mr.Position + dir)
end

local function swingTool(tool)
    local remote = tool:FindFirstChild("Activate")
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer()
    else
        tool:Activate()
    end
end

-- ── KILL AURA ───────────────────────────────────
local function getTargets()
    local out = {}
    local mc  = getChar(LocalPlayer)
    if not mc then return out end
    local mr  = getRoot(mc)
    if not mr then return out end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if sameTeam(p) then continue end
        if not isAlive(p) then continue end
        local d = distTo(p)
        if d <= State.auraRadius then
            table.insert(out, {player = p, dist = d})
        end
    end

    if State.auraPriority == "Nearest" then
        table.sort(out, function(a, b) return a.dist < b.dist end)
    elseif State.auraPriority == "Lowest HP" then
        table.sort(out, function(a, b)
            local ha = getHum(getChar(a.player))
            local hb = getHum(getChar(b.player))
            return (ha and ha.Health or math.huge) < (hb and hb.Health or math.huge)
        end)
    elseif State.auraPriority == "Highest HP" then
        table.sort(out, function(a, b)
            local ha = getHum(getChar(a.player))
            local hb = getHum(getChar(b.player))
            return (ha and ha.Health or 0) > (hb and hb.Health or 0)
        end)
    elseif State.auraPriority == "Furthest" then
        table.sort(out, function(a, b) return a.dist > b.dist end)
    end

    return out
end

local function killAuraTick()
    if not State.auraEnabled then return end
    local now = tick()
    if now - State.lastSwing < State.auraInterval then return end

    local mc = getChar(LocalPlayer)
    if not mc then return end
    local mh = getHum(mc)
    if not mh or mh.Health <= 0 then return end

    local targets = getTargets()
    if #targets == 0 then return end

    local tool = ensureTool()
    if not tool then return end

    local tc = getChar(targets[1].player)
    local tr = getRoot(tc)
    if not tr then return end

    if State.auraFace then faceTarget(tr) end
    swingTool(tool)
    State.lastSwing = now
end

-- ── ESP ─────────────────────────────────────────
local function removeESP(p)
    local e = State.espObjects[p]
    if not e then return end
    pcall(function()
        if e.billboard and e.billboard.Parent then e.billboard:Destroy() end
        if e.highlight  and e.highlight.Parent  then e.highlight:Destroy()  end
    end)
    State.espObjects[p] = nil
end

local function buildESP(p)
    if State.espObjects[p] then return end

    local bb = Instance.new("BillboardGui")
    bb.Name             = "MTC_ESP"
    bb.AlwaysOnTop      = true
    bb.Size             = UDim2.new(0, 200, 0, 50)
    bb.StudsOffset      = Vector3.new(0, 3.2, 0)
    bb.ResetOnSpawn     = false

    local nameL = Instance.new("TextLabel")
    nameL.Size                   = UDim2.new(1, 0, 0.5, 0)
    nameL.BackgroundTransparency = 1
    nameL.TextColor3             = Color3.fromRGB(255, 255, 255)
    nameL.TextStrokeTransparency = 0
    nameL.Font                   = Enum.Font.GothamBold
    nameL.TextScaled             = true
    nameL.Text                   = p.Name
    nameL.Parent                 = bb

    local hpL = Instance.new("TextLabel")
    hpL.Size                   = UDim2.new(1, 0, 0.5, 0)
    hpL.Position               = UDim2.new(0, 0, 0.5, 0)
    hpL.BackgroundTransparency = 1
    hpL.TextColor3             = Color3.fromRGB(80, 255, 80)
    hpL.TextStrokeTransparency = 0
    hpL.Font                   = Enum.Font.Gotham
    hpL.TextScaled             = true
    hpL.Text                   = "HP: ?"
    hpL.Parent                 = bb

    local hl = Instance.new("SelectionBox")
    hl.Color3               = State.espBoxColor
    hl.LineThickness        = 0.05
    hl.SurfaceTransparency = 1
    hl.SurfaceColor3       = State.espBoxColor

    State.espObjects[p] = { billboard = bb, nameLabel = nameL, hpLabel = hpL, highlight = hl }
end

local function updateESP()
    if not State.espEnabled then
        for p in pairs(State.espObjects) do removeESP(p) end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c  = getChar(p)
        local h  = c and getHum(c)
        local tr = c and getRoot(c)

        if not c or not h or not tr or distTo(p) > State.espMaxDist then
            removeESP(p)
            continue
        end

        if not State.espObjects[p] then buildESP(p) end
        local e = State.espObjects[p]
        if not e then continue end

        -- Reattach billboard
        if e.billboard.Parent ~= tr then e.billboard.Parent = tr end

        -- Reattach highlight
        if e.highlight.Adornee ~= c then
            e.highlight.Adornee = c
            e.highlight.Parent  = c
        end

        -- Visibility toggles
        e.highlight.Visible   = State.espBoxes
        e.nameLabel.Visible   = State.espNames
        e.hpLabel.Visible     = State.espHealth or State.espDistance

        -- Name + distance
        local dist = distTo(p)
        local nameText = State.espNames and p.Name or ""
        if State.espDistance then
            nameText = nameText .. string.format(" [%.0f]", dist)
        end
        e.nameLabel.Text = nameText

        -- HP text + color
        if State.espHealth then
            local hp    = math.floor(h.Health)
            local maxhp = math.max(math.floor(h.MaxHealth), 1)
            local ratio = math.clamp(h.Health / maxhp, 0, 1)
            e.hpLabel.Text       = string.format("HP: %d/%d", hp, maxhp)
            e.hpLabel.TextColor3 = Color3.fromRGB(
                math.floor((1 - ratio) * 255),
                math.floor(ratio * 255),
                0
            )
        end

        -- Box color sync
        e.highlight.Color3 = State.espBoxColor
    end

    for p in pairs(State.espObjects) do
        if not p or not p.Parent then removeESP(p) end
    end
end

-- ── CHAMS ───────────────────────────────────────
local MATERIAL_MAP = {
    Neon          = Enum.Material.Neon,
    Glass         = Enum.Material.Glass,
    Foil          = Enum.Material.Foil,
    SmoothPlastic = Enum.Material.SmoothPlastic,
}

local function applyChams(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if not State.chamsObjects[part] then
                State.chamsObjects[part] = { mat = part.Material, col = part.Color }
            end
            part.Material = State.chamsMaterial
            part.Color    = State.chamsColor
        end
    end
end

local function removeChams(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local orig = State.chamsObjects[part]
            if orig then
                part.Material = orig.mat
                part.Color    = orig.col
                State.chamsObjects[part] = nil
            end
        end
    end
end

local function updateChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local c = getChar(p)
        if not c then continue end
        if State.chamsEnabled then
            applyChams(c)
        else
            removeChams(c)
        end
    end
end

