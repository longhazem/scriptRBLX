local TargetBox   = Tabs.Combat:AddRightGroupbox("Target")
local targetLabel = TargetBox:AddLabel("Aura disabled")
local countLabel  = TargetBox:AddLabel("Targets in range: 0")

task.spawn(function()
    while task.wait(0.3) do
        if not State.auraEnabled then
            targetLabel:SetText("Aura disabled")
            countLabel:SetText("Targets in range: 0")
            continue
        end
        local targets = getAllTargets()
        countLabel:SetText("Targets in range: " .. #targets)
        if #targets > 0 then
            local t  = targets[1]
