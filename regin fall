local function SetAllVisible(d, visible)
    local boxOn = visible and Config.UseBoxESP
    pcall(function() d.Box.Visible=boxOn; d.BoxOutline.Visible=boxOn end)
    pcall(function() d.Name.Visible=visible and Config.ShowNames end)
    pcall(function() d.Distance.Visible=visible and Config.ShowDistance end)
    local healthOn = visible and Config.ShowHealth
    pcall(function() d.HealthBar.Visible=healthOn; d.HealthBarOutline.Visible=healthOn end)
    pcall(function() d.Tracer.Visible=visible and Config.UseTracers end)
    if not visible then
        for _, l in ipairs(d.Corners) do pcall(function() l.Visible=false end) end
    end
end

local function RemoveDrawingESP(d, highlight)
    pcall(function() d.Box:Remove() end); pcall(function() d.BoxOutline:Remove() end)
    pcall(function() d.Name:Remove() end); pcall(function() d.Distance:Remove() end)
    pcall(function() d.HealthBar:Remove() end); pcall(function() d.HealthBarOutline:Remove() end)
    pcall(function() d.Tracer:Remove() end)
    for _, l in ipairs(d.Corners) do pcall(function() l:Remove() end) end
    if highlight then pcall(function() highlight:Destroy() end) end
end

local function UpdateDrawingForModel(model, espData, entityColor, showBox, showHealth, showName, showDist)
    local d = espData.Drawing
    -- root: R6 dùng Torso, R15 dùng HumanoidRootPart
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart
    if not root then SetAllVisible(d, false); return end

    local worldPos = root.Position
    local dist = (camera.CFrame.Position - worldPos).Magnitude
    if dist > Config.MaxDistance then SetAllVisible(d, false); return end

    -- LOD skip như BRM5: xa > 1500 skip 3/4 frame, xa > 500 skip 1/2 frame
    local fid = espData.FrameId or 0
    espData.FrameId = fid + 1
    if dist > 1500 and (fid % 4) ~= 0 then return end
    if dist > 500  and (fid % 2) ~= 0 then return end

    local screenPt, onScreen = camera:WorldToViewportPoint(worldPos)
    if not onScreen then SetAllVisible(d, false); return end

    local screenPos = Vector2.new(screenPt.X, screenPt.Y)

    -- Highlight (xuyên tường)
    if Config.UseHighlight then
        if not espData.Highlight then
            local h = Instance.new("Highlight")
            h.FillColor = entityColor; h.OutlineColor = entityColor
            h.FillTransparency = 0.6; h.OutlineTransparency = 0
            pcall(function() h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop end)
            h.Parent = model; espData.Highlight = h
        end
        espData.Highlight.FillColor = entityColor; espData.Highlight.OutlineColor = entityColor
    else
        if espData.Highlight then
            pcall(function() espData.Highlight:Destroy() end); espData.Highlight = nil
        end
    end

    -- box size (y chang BRM5)
    local height = 6.5
    local topPt    = camera:WorldToViewportPoint(worldPos + Vector3.new(0,  height*0.5, 0))
    local bottomPt = camera:WorldToViewportPoint(worldPos - Vector3.new(0,  height*0.5, 0))
    local boxHeight = math.abs(bottomPt.Y - topPt.Y)
    if boxHeight < 4 then SetAllVisible(d, false); return end
    local boxWidth = boxHeight * 0.6
    local boxPosition = Vector2.new(screenPos.X - boxWidth*0.5, screenPos.Y - boxHeight*0.5)
    local boxColor = Config.BoxColor or entityColor

    -- box style (y chang BRM5: Full hoặc Corner)
    if showBox and Config.UseBoxESP then
        if Config.BoxStyle == "Corner" then
            pcall(function() d.Box.Visible=false; d.BoxOutline.Visible=false end)
            local cl = math.min(boxWidth, boxHeight) * 0.25
            local corners = d.Corners
            local bpX,bpY = boxPosition.X, boxPosition.Y
            local rx, by = bpX+boxWidth, bpY+boxHeight
            pcall(function()
                corners[1].From=Vector2.new(bpX,bpY);  corners[1].To=Vector2.new(bpX+cl,bpY); corners[1].Color=boxColor; corners[1].Visible=true
                corners[2].From=Vector2.new(bpX,bpY);  corners[2].To=Vector2.new(bpX,bpY+cl); corners[2].Color=boxColor; corners[2].Visible=true
                corners[3].From=Vector2.new(rx,bpY);   corners[3].To=Vector2.new(rx-cl,bpY);  corners[3].Color=boxColor; corners[3].Visible=true
                corners[4].From=Vector2.new(rx,bpY);   corners[4].To=Vector2.new(rx,bpY+cl);  corners[4].Color=boxColor; corners[4].Visible=true
                corners[5].From=Vector2.new(bpX,by);   corners[5].To=Vector2.new(bpX+cl,by);  corners[5].Color=boxColor; corners[5].Visible=true
                corners[6].From=Vector2.new(bpX,by);   corners[6].To=Vector2.new(bpX,by-cl);  corners[6].Color=boxColor; corners[6].Visible=true
                corners[7].From=Vector2.new(rx,by);    corners[7].To=Vector2.new(rx-cl,by);   corners[7].Color=boxColor; corners[7].Visible=true
                corners[8].From=Vector2.new(rx,by);    corners[8].To=Vector2.new(rx,by-cl);   corners[8].Color=boxColor; corners[8].Visible=true
            end)
        else
            pcall(function()
                if d.Corners[1].Visible then for _, l in ipairs(d.Corners) do l.Visible=false end end
                d.BoxOutline.Size=Vector2.new(boxWidth,boxHeight); d.BoxOutline.Position=boxPosition; d.BoxOutline.Visible=true
                d.Box.Size=Vector2.new(boxWidth,boxHeight); d.Box.Position=boxPosition; d.Box.Color=boxColor; d.Box.Visible=true
            end)
        end
    else
        pcall(function() d.Box.Visible=false; d.BoxOutline.Visible=false end)
        for _, l in ipairs(d.Corners) do pcall(function() l.Visible=false end) end
    end

    -- name
    if showName and Config.ShowNames then
        pcall(function()
            d.Name.Text = model.Name ~= "" and model.Name or "Enemy"
            d.Name.Position = Vector2.new(screenPos.X, boxPosition.Y - 16)
            d.Name.Color = entityColor; d.Name.Visible = true
        end)
    else pcall(function() d.Name.Visible=false end) end

    -- distance
    if showDist and Config.ShowDistance then
        pcall(function()
            local distY = boxPosition.Y + boxHeight + 2
            if Config.HealthBarSide == "Bottom" then distY = distY + 6 end
            d.Distance.Text = string.format("[%dm]", math.floor(dist * 0.28))
            d.Distance.Position = Vector2.new(screenPos.X, distY)
            d.Distance.Visible = true
        end)
    else pcall(function() d.Distance.Visible=false end) end

    -- health bar (y chang BRM5: Left / Right / Bottom)
    if showHealth and Config.ShowHealth then
        pcall(function()
            local humanoid = model:FindFirstChild("Humanoid")
            local hValues  = humanoid and humanoid:FindFirstChild("Values")
            local healthNV = hValues and hValues:FindFirstChild("Health")
            local maxNV    = healthNV and healthNV:FindFirstChild("Max")
            local pct = 1
            if healthNV and maxNV and maxNV.Value > 0 then
                pct = math.clamp(healthNV.Value / maxNV.Value, 0, 1)
            elseif humanoid and humanoid.MaxHealth > 0 then
                pct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            end
            local barColor = Config.UseHealthGradient and Color3.fromHSV(pct*0.33,1,1) or Config.HealthBarColor
            local barSize, barPos, outlineSize, outlinePos
            if Config.HealthBarSide == "Bottom" then
                local barW = boxWidth * pct
                barSize=Vector2.new(barW,4); barPos=Vector2.new(boxPosition.X,boxPosition.Y+boxHeight+2)
                outlineSize=Vector2.new(boxWidth+2,6); outlinePos=Vector2.new(boxPosition.X-1,boxPosition.Y+boxHeight+1)
            elseif Config.HealthBarSide == "Right" then
                local barH = boxHeight * pct
                barSize=Vector2.new(2,barH); barPos=Vector2.new(boxPosition.X+boxWidth+3,boxPosition.Y+(boxHeight-barH))
                outlineSize=Vector2.new(4,boxHeight+2); outlinePos=Vector2.new(boxPosition.X+boxWidth+2,boxPosition.Y-1)
            else -- Left
                local barH = boxHeight * pct
                barSize=Vector2.new(2,barH); barPos=Vector2.new(boxPosition.X-5,boxPosition.Y+(boxHeight-barH))
                outlineSize=Vector2.new(4,boxHeight+2); outlinePos=Vector2.new(boxPosition.X-6,boxPosition.Y-1)
            end
            d.HealthBarOutline.Size=outlineSize; d.HealthBarOutline.Position=outlinePos; d.HealthBarOutline.Visible=true
            d.HealthBar.Size=barSize; d.HealthBar.Position=barPos; d.HealthBar.Color=barColor; d.HealthBar.Visible=true
        end)
    else pcall(function() d.HealthBar.Visible=false; d.HealthBarOutline.Visible=false end) end

    -- tracer (y chang BRM5)
    if Config.UseTracers then
        pcall(function()
            local vp = camera.ViewportSize
            d.Tracer.From=Vector2.new(vp.X*0.5,vp.Y)
            d.Tracer.To=Vector2.new(screenPos.X,boxPosition.Y+boxHeight)
            d.Tracer.Color=entityColor; d.Tracer.Visible=true
        end)
    else pcall(function() d.Tracer.Visible=false end) end
end

local function UpdateEntityESP()
    local alive = {}

    if Config.zombieESP then
        local container = getEnemyContainer()
        if container then
            for _, zombie in ipairs(container:GetChildren()) do
                if zombie:IsA("Model") and zombie:FindFirstChild("Humanoid") then
                    alive[zombie] = true
                    if not drawingPool[zombie] then
                        drawingPool[zombie] = {Drawing = CreateDrawingESP(), Highlight = nil, FrameId = 0}
                    end
                    UpdateDrawingForModel(zombie, drawingPool[zombie], Config.ZombieColor,
                        Config.zombieBox, Config.zombieHealth, Config.zombieName, Config.zombieDistance)
                end
            end
        end
    end

    if Config.playerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character and player.Character:FindFirstChild("Humanoid") then
                local char = player.Character
                alive[char] = true
                if not drawingPool[char] then
                    drawingPool[char] = {Drawing = CreateDrawingESP(), Highlight = nil, FrameId = 0}
                end
                UpdateDrawingForModel(char, drawingPool[char], Config.PlayerColor,
                    Config.playerBox, Config.playerHealth, Config.playerName, Config.playerDistance)
            end
        end
    end

    -- cleanup stale
    for model, espData in pairs(drawingPool) do
        if not alive[model] then
            RemoveDrawingESP(espData.Drawing, espData.Highlight)
            drawingPool[model] = nil
        end
    end
end

