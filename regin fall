local function getClosestHead()
    local container = getEnemyContainer()
    if not container then return nil end
    local referencePos = isMobile
        and Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
        or UserInputService:GetMouseLocation()
    local bestPos, bestDist = nil, math.huge
    for _, enemy in ipairs(container:GetChildren()) do
        local head = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
        if head then
            local sp, onScreen = camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - referencePos).Magnitude
                if d < bestDist then bestDist = d; bestPos = head.Position end
            end
        end
    end
    return bestPos
end

RunService.Heartbeat:Connect(function()
    if Config.raycasting and target.enabled then
        target.position = getClosestHead()
    else
        target.position = nil
    end
end)

-- ─── NAMECALL HOOK (Silent Aim + No Spread) ───────────────────────────────────

local RAYCAST_METHOD = "Raycast"
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if self ~= Workspace or getnamecallmethod() ~= RAYCAST_METHOD then
        return oldNamecall(self, ...)
    end
    local origin, dir, params = ...
    if not params or params.CollisionGroup ~= "raycast_npc_neutral" then
        return oldNamecall(self, ...)
    end
    local doSpread = Config.noSpread
    local doSilent = Config.raycasting and target.position ~= nil
    if not doSpread and not doSilent then return oldNamecall(self, ...) end
    if doSpread then
        dir = camera.CFrame.LookVector * dir.Magnitude
    end
    if doSilent then
        local toTarget = target.position - origin
        if toTarget.Magnitude > 0.001 then dir = toTarget.Unit * dir.Magnitude end
    end
    return oldNamecall(self, origin, dir, params)
end))

