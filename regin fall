-- ─── NO RECOIL ────────────────────────────────────────────────────────────────

local ZERO_CFRAME = CFrame.new()
local recoilHook

local function installRecoilHook()
    if recoilHook then return end
    recoilHook = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if Config.noRecoil then
            if key == "Value" and typeof(value) == "CFrame" and self:IsA("CFrameValue")
            and (self.Name == "camera_recoil" or self.Name == "visual_recoil") then
                return recoilHook(self, key, ZERO_CFRAME)
            end
            if key == "NearIntensity" and self:IsA("BlurEffect") and self.Name == "VisualRecoilBlur" then
                return recoilHook(self, key, 0)
            end
        end
        return recoilHook(self, key, value)
    end))
end
installRecoilHook()

-- ─── PICKUP HIGHLIGHT UTILS ───────────────────────────────────────────────────

local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent then return end
    pcall(function()
        local h = obj:FindFirstChild("TokaiHL") or Instance.new("Highlight")
        h.Name = "TokaiHL"
        h.FillColor = color; h.OutlineColor = color
        h.FillTransparency = transparency or 0.3; h.OutlineTransparency = 0
        h.Parent = obj; highlightObjects[obj] = true
    end)
end

local function RemoveHighlight(obj)
    pcall(function()
        local h = obj:FindFirstChild("TokaiHL")
        if h then h:Destroy() end
        highlightObjects[obj] = nil
    end)
end

-- ─── HITBOX EXPANDER ──────────────────────────────────────────────────────────

local function restoreHitbox(part)
    local orig = expandedHitboxes[part]
    if orig and part and part.Parent then
        pcall(function() part.Size = orig.size; part.Transparency = orig.transparency end)
    end
    expandedHitboxes[part] = nil
end

local function expandHitbox(part)
    if not part or not part:IsA("BasePart") or part.Name ~= "Head" then return end
    if not Config.hitboxExpander then return end
    local model = part.Parent
    if not model or not model:FindFirstChild("Humanoid") then return end
    if Players:GetPlayerFromCharacter(model) ~= nil then return end
    pcall(function()
        if not expandedHitboxes[part] then
            expandedHitboxes[part] = {size = part.Size, transparency = part.Transparency}
        end
        part.Size = Vector3.new(Config.hitboxSize, Config.hitboxSize, Config.hitboxSize)
        part.CanCollide = false; part.Transparency = 0.7
    end)
end

local function cleanupNPC(npcModel)
    local tracked = trackedNPCs[npcModel]
    if not tracked then return end
    for _, conn in ipairs(tracked.connections) do pcall(function() conn:Disconnect() end) end
    for _, part in ipairs(tracked.parts) do restoreHitbox(part) end
    trackedNPCs[npcModel] = nil
end

local function trackNPC(npcModel)
    if trackedNPCs[npcModel] then return end
    local humanoid = npcModel:FindFirstChild("Humanoid")
    if not humanoid then return end
    local connections, parts = {}, {}
    local head = npcModel:FindFirstChild("Head")
    if head then expandHitbox(head); table.insert(parts, head) end
    local c1 = npcModel.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and desc.Name == "Head" then
            task.wait(0.05); expandHitbox(desc); table.insert(parts, desc)
        end
    end)
    local c2 = humanoid.Died:Connect(function()
        task.wait(0.1); cleanupNPC(npcModel)
    end)
    local c3 = npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanupNPC(npcModel) end
    end)
    table.insert(connections, c1); table.insert(connections, c2); table.insert(connections, c3)
    trackedNPCs[npcModel] = {connections = connections, parts = parts}
end

local function untrackAllNPCs()
    for npc in pairs(trackedNPCs) do cleanupNPC(npc) end
    trackedNPCs = {}; expandedHitboxes = {}
end

