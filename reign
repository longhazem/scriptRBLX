-- CanSourceAttackTarget nằm trong ReplicatedStorage nên client require được; đây là đúng hàm server dùng để nhận hit
local canAttackFn = nil
local function getCanAttack()
    if canAttackFn == nil then
        local ok, fn = pcall(function()
            return require(game:GetService("ReplicatedStorage").Functions.Gameplay.DamageSystem.GetValues.CanSourceAttackTarget)
        end)
