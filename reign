    ["Left Arm"]     = {"Left Arm", "LeftUpperArm", "LeftLowerArm", "Torso"},
    ["Right Arm"]    = {"Right Arm", "RightUpperArm", "RightLowerArm", "Torso"},
    ["Left Leg"]     = {"Left Leg", "LeftUpperLeg", "LeftLowerLeg", "HumanoidRootPart"},
    ["Right Leg"]    = {"Right Leg", "RightUpperLeg", "RightLowerLeg", "HumanoidRootPart"},
}

local function getPartFromModel(model, partName)
    local part = model:FindFirstChild(partName)
    if part and part:IsA("BasePart") then return part end
    local fallbacks = PART_FALLBACKS[partName]
    if fallbacks then
        for _, name in ipairs(fallbacks) do
            local p = model:FindFirstChild(name)
            if p and p:IsA("BasePart") then return p end
        end
    end
    return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model.PrimaryPart
end

local function getNearestEnemyInFOV()
    local container = getEnemyContainer()
    if not container then return nil, nil end
    local referencePos = isMobile and getScreenCenter() or Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local bestModel, bestPart, bestDist = nil, nil, math.huge

    for _, enemy in ipairs(container:GetChildren()) do
        if enemy:IsA("Model") then
            local humanoid = enemy:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                -- dùng Head để tính FOV screen dist (luôn visible trên screen)
                local head = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
                if head and Config.aimMaxDistance > 0 and (head.Position - camera.CFrame.Position).Magnitude > Config.aimMaxDistance then head = nil end
                if head then
                    local screenPt, onScreen = camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPt.X, screenPt.Y) - referencePos).Magnitude
                        if screenDist <= Config.aimbotFOV and screenDist < bestDist then
                            -- lấy part theo config để aim vào
                            local aimPart = getPartFromModel(enemy, Config.aimbotPart)
                            if aimPart and isVisible(aimPart.Position) then
                                bestModel = enemy
                                bestPart  = aimPart
                                bestDist  = screenDist
                            end
                        end
                    end
                end
            end
        end
    end
    return bestModel, bestPart
end

-- Silent Aim cũng dùng chung FOV + wallcheck
local getBulwarkBackPosition   -- forward decl: def nằm dưới, tránh gọi nil
local function getClosestHead()
    local container = getEnemyContainer()
    if not container then return nil end
    local referencePos = isMobile and getScreenCenter() or Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local bestPos, bestDist = nil, math.huge

    for _, enemy in ipairs(container:GetChildren()) do
        -- dùng Head để check FOV (luôn visible, consistent)
        local fovPart = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Torso")
        if not fovPart then continue end

        local sp, onScreen = camera:WorldToViewportPoint(fovPart.Position)
        if not onScreen then continue end

        local screenDist = (Vector2.new(sp.X, sp.Y) - referencePos).Magnitude
        if screenDist > Config.aimbotFOV or screenDist >= bestDist then continue end

        -- lấy actual aim position từ silentAimPart
        local aimPos
        if enemy.Name == BULWARK_NAME then
            aimPos = getBulwarkBackPosition(enemy)
        else
            local aimPart = getPartFromModel(enemy, Config.silentAimPart)
            aimPos = aimPart and aimPart.Position
        end
        if not aimPos then continue end

        if isVisible(aimPos) then
            bestDist = screenDist
            bestPos = aimPos
        end
    end
    return bestPos
end

-- Aimbot RenderStepped — lerp camera CFrame về target
RunService.RenderStepped:Connect(function(dt)
    local targetModel, targetPart = getNearestEnemyInFOV()
    aimbotLocked = targetModel
    updateFOVCircle()
    if not Config.aimbotEnabled then return end
    if not targetPart then return end
    local aimPos = targetPart.Position + Vector3.new(0, 0.15, 0)
    local camCFrame = camera.CFrame
    local camPos = camCFrame.Position
    local lookVector = (aimPos - camPos).Unit
    local targetCFrame = CFrame.new(camPos, camPos + lookVector)
    local smoothFactor = math.clamp(1 - math.pow(Config.aimbotSmoothing, dt * 60), 0, 1)
    camera.CFrame = camCFrame:Lerp(targetCFrame, smoothFactor)
end)

function getBulwarkBackPosition(model)
    -- vị trí sau lưng bulwark = HumanoidRootPart.Position - LookVector * 1.5
    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not root then return nil end
    return root.Position - (root.CFrame.LookVector * 1.5) + Vector3.new(0, 0.5, 0)
end

