Library:OnUnload(function()
    untrackAllNPCs()
    for obj, conn in pairs(trackedPickups) do
        pcall(function() conn:Disconnect() end); RemoveHighlight(obj)
    end
    trackedPickups = {}
    for _, espData in pairs(drawingPool) do
        RemoveDrawingESP(espData.Drawing, espData.Highlight)
    end
    drawingPool = {}
    pcall(function() fovCircle:Remove() end)
    pcall(function() if crosshairGui then crosshairGui:Destroy() end end)
    pcall(function() afkConn:Disconnect() end)
    pcall(function() hotkeyConn:Disconnect() end)
    pcall(function() avoidConn:Disconnect() end)
    pcall(function() noclipConn:Disconnect() end)
    Config.noClip = false
    restoreNoClip()
    Config.avoidZombies = false
    Config.hipHeightOn = false
    if setfpscap then Config.fpsCapOn = false; applyFpsCap() end
    setBooster(false)
    Config.autoRespawn = false
    Config.autoAbility = false
    setSkyZone(false)
    setChurchFarm(false)
    setBoosterV2(false)
    if bringConn then pcall(function() bringConn:Disconnect() end) end
    Config.bringZombies = false
    Library.Unloaded = true
end)
