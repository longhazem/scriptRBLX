local RAYCAST_METHOD = "Raycast"
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Config.antiKick and self == lp and method:lower() == "kick" then return end

    -- Silent Aim + No Spread
    if method == RAYCAST_METHOD and self == Workspace then
        local origin, dir, params = ...
        if params and params.CollisionGroup == "raycast_npc_neutral" then
            local doSpread = Config.noSpread
            local doSilent = Config.raycasting and target.position ~= nil
            if doSpread or doSilent then
                if doSpread then dir = camera.CFrame.LookVector * dir.Magnitude end
                if doSilent then
                    local toTarget = target.position - origin
                    if toTarget.Magnitude > 0.001 then dir = toTarget.Unit * dir.Magnitude end
                end
                return oldNamecall(self, origin, dir, params)
            end
        end
    end

    return oldNamecall(self, ...)
end))

-- ─── AUTO HIT (zombie / boss / bulwark; bắn từng slot primary / secondary / melee) ─

local HIT_SLOTS = {"primary", "secondary", "melee"}

local function getNamedFolder(...)
    local node = workspace
    for _, name in ipairs({...}) do
        node = node and node:FindFirstChild(name)
    end
    return node
end

local function getSlotHitEvent(slotName)
    local char = lp.Character
    local slot = char and char:FindFirstChild(slotName)
    local se   = slot and slot:FindFirstChild("ServerEvents")
    local re   = se and se:FindFirstChild("RegisterHit")
    if re and re:IsA("RemoteEvent") then return re end
    return nil
end

local function getHitPart(npc)
    return npc:FindFirstChild("Head") or npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
end

local function isAliveNPC(npc)
    local hum = npc:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function collectHitTargets(wantZombies, wantBosses, wantBulwark)
    local out = {}
    local function add(npc, kind)
        if not npc:IsA("Model") or not isAliveNPC(npc) then return end
        local part = getHitPart(npc)
        if part then table.insert(out, {model = npc, part = part, kind = kind}) end
    end

    if wantZombies or wantBulwark then
        local enemies = getNamedFolder("Game", "Current", "Spawned", "NPCs", "enemies")
        if enemies then
            for _, npc in ipairs(enemies:GetChildren()) do
                if npc.Name == BULWARK_NAME then
                    if wantBulwark then add(npc, "bulwark") end
                elseif wantZombies then
                    add(npc, "zombie")
                end
            end
        end
    end

    if wantZombies then
        local ragdolls = getNamedFolder("Game", "Spawned", "Ragdolls")
        local corpses  = getNamedFolder("Game", "Current", "Scene", "Map", "Corpses")
        if ragdolls then
            for _, npc in ipairs(ragdolls:GetChildren()) do add(npc, "zombie") end
        end
        if corpses then
            for _, npc in ipairs(corpses:GetChildren()) do add(npc, "zombie") end
        end
    end

    if wantBosses then
        local bosses = getNamedFolder("Game", "Current", "Spawned", "NPCs", "bosses")
        if bosses then
            for _, npc in ipairs(bosses:GetChildren()) do add(npc, "boss") end
        end
    end

    return out
end

local function fireHits(targets)
    if #targets == 0 then return end

    local slotEvents = {}
    for _, slotName in ipairs(HIT_SLOTS) do
        local enabled = (slotName == "primary" and Config.hitPrimary)
            or (slotName == "secondary" and Config.hitSecondary)
            or (slotName == "melee" and Config.hitMelee)
        if enabled then
            local re = getSlotHitEvent(slotName)
            if re then table.insert(slotEvents, re) end
        end
    end
    if #slotEvents == 0 then return end

    local normal, bulwarks = {}, {}
    for _, t in ipairs(targets) do
        if t.kind == "bulwark" then
            table.insert(bulwarks, t)
        else
            table.insert(normal, {amount = 1, target = t.model, is_friendly = false, part = t.part})
        end
    end

    for _, re in ipairs(slotEvents) do
        if #normal > 0 then
            pcall(function() re:FireServer(normal, {}) end)
        end
        for _, t in ipairs(bulwarks) do
            local char    = lp.Character
            local root    = char and char:FindFirstChild("HumanoidRootPart")
            local backPos = getBulwarkBackPosition(t.model)
            if root and backPos then
                local original = root.CFrame
                pcall(function() root.CFrame = CFrame.new(backPos, t.part.Position) end)
                pcall(function() re:FireServer({{amount = 1, target = t.model, is_friendly = false, part = t.part}}, {}) end)
                pcall(function() root.CFrame = original end)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        local zombiesOn   = Config.autoHit or Config.churchFarm
        local wantZombies = zombiesOn and not Config.bulwarkOnly
        local wantBulwark = (Config.hitBulwark or zombiesOn) and true or false
        local wantBosses  = Config.hitBosses and true or false
        if wantZombies or wantBulwark or wantBosses then
            pcall(function()
                fireHits(collectHitTargets(wantZombies, wantBosses, wantBulwark))
            end)
        end
    end
end)

