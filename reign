Window:OnUnload(function()
    pcall(function() if Library.ESP then Library.ESP:Clear() end end)
    untrackAllNPCs()
    for obj, conn in pairs(trackedPickups) do
        pcall(function() conn:Disconnect() end); RemoveHighlight(obj)
    end
    trackedPickups = {}
    pcall(function() fovCircle:Remove() end)
    pcall(function() if crosshairGui then crosshairGui:Destroy() end end)
    pcall(function() afkConn:Disconnect() end)
    pcall(function() avoidConn:Disconnect() end)
    pcall(function() noclipConn:Disconnect() end)
    Config.noClip = false
    restoreNoClip()
    Config.avoidZombies = false
    Config.hipHeightOn = false
    if setfpscap then Config.fpsCapOn = false; applyFpsCap() end
    setBooster(false)
    Config.autoRespawn = false
    Config.autoAbility = false
    setSkyZone(false)
    setChurchFarm(false)
    setBoosterV2(false)
    if bringConn then pcall(function() bringConn:Disconnect() end) end
    Config.bringZombies = false
    Config.headForce = false
    Config.rpmEnabled = false
    Config.pumpSpeedOn = false
    Config.reloadSpeedOn = false
    Config.infiniteAmmo = false
    Config.runAndGun = false
    Config.sprintAnywhere = false
    Config.jumpOn = false
    Config.interactEspOn = false
    pcall(applyCharFlags)
    pcall(refreshInteractEsp)
    pcall(GunMods.applyCharStats)
    Config.meleeSpeedOn = false
    Config.adsOn = false
    Config.pierceOn = false
    Config.noSpreadOn = false
    Config.noVisualRecoilOn = false
    Library.Unloaded = true
end)
