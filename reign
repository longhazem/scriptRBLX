local avoidConn = RunService.Heartbeat:Connect(function()
    if not Config.avoidZombies then return end
    local char      = lp.Character
    local hrp       = char and char:FindFirstChild("HumanoidRootPart")
    local container = getEnemyContainer()
    if not (hrp and container) then return end

    local nearest, nearestDist = nil, math.huge
    for _, npc in ipairs(container:GetChildren()) do
        local root = npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart")
        if root then
            local d = (root.Position - hrp.Position).Magnitude
            if d < nearestDist then nearest, nearestDist = root, d end
        end
    end

    if nearest and nearestDist < Config.avoidDistance then
        local away = hrp.Position - nearest.Position
        if away.Magnitude > 0.01 then
            local newPos = hrp.Position + away.Unit * (Config.avoidDistance - nearestDist + 1)
            pcall(function() hrp.CFrame = CFrame.new(newPos, newPos + hrp.CFrame.LookVector) end)
        end
    end
end)

