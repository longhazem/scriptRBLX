-- fired_valid: số lần RegisterHit server còn nhận cho tool này (mỗi lần gọi trừ 1, ReloadAmmo cộng lại)
local function getBudget(tool)
    local vals = tool and tool:FindFirstChild("Values")
    local fv   = vals and vals:FindFirstChild("fired_valid")
    if fv and fv:IsA("NumberValue") then return fv.Value end
