local ZERO_CFRAME = CFrame.new()
local recoilHook

local function installRecoilHook()
    if recoilHook then return end
    recoilHook = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if Config.noRecoil then
            if key == "Value" and typeof(value) == "CFrame" and self:IsA("CFrameValue")
            and (self.Name == "camera_recoil" or self.Name == "visual_recoil") then
                return recoilHook(self, key, ZERO_CFRAME)
            end
            if key == "NearIntensity" and self:IsA("BlurEffect") and self.Name == "VisualRecoilBlur" then
                return recoilHook(self, key, 0)
            end
        end
        return recoilHook(self, key, value)
    end))
end
installRecoilHook()

-- ─── GUN MODS (RPM, melee speed, ADS, pierce, spread, visual recoil) ──────────
-- Chuỗi: FetchWeaponInfo (mỗi lần equip) → CreateFullGunset → gunset.weapon_stats → viewmodel đọc.
-- Hook CreateFullGunset một lần lúc load; từng flag trong Config quyết định có đổi hay không.
-- Đổi xong phải equip lại súng/melee mới có hiệu lực.
local GunMods = {}
do
    local RPM_MIN, RPM_MAX = 10, 2000   -- ClampValues.firerate của game

    local function clampRpm(v)
        return math.clamp(v, RPM_MIN, RPM_MAX)
    end

    local function getWeaponNames()
        local names = {}
        local ok, list = pcall(function()
            return game:GetService("ReplicatedStorage").Assets.Weapons.List:GetChildren()
        end)
        if ok and list then
            for _, inst in ipairs(list) do table.insert(names, inst.Name) end
        end
        table.sort(names)
        return names
    end

    local function applyGunMods(gunset)
        local ws = gunset and gunset.weapon_stats
        if not ws then return end
        local isMelee = ws.is_melee == true

        -- RPM súng (firerate) và nhịp đánh melee (firerate + heavy_melee_firerate)
        local base = tonumber(ws.firerate)
        if base and base > 0 then
            local newRate = nil
            if isMelee then
                if Config.meleeSpeedOn then
                    newRate = base * Config.meleeSpeed
                    local heavy = tonumber(ws.heavy_melee_firerate)
                    if heavy then ws.heavy_melee_firerate = clampRpm(heavy * Config.meleeSpeed) end
                end
            elseif Config.rpmEnabled then
                newRate = Config.rpmPerGun[ws.weapon_name]
                if not newRate and Config.rpmMultiplier ~= 1 then
                    newRate = base * Config.rpmMultiplier
                end
            end
            if newRate then
                newRate = clampRpm(newRate)
                local ratio = newRate / base
                ws.firerate = newRate
                local burst = tonumber(ws.firerate_burst)
                if ws.firemode == "burst" and burst then
                    ws.firerate_burst = clampRpm(burst * ratio)
                end
            end
        end

        if Config.adsOn then
            local ads = tonumber(ws.aim_speed_multiplier)
            if ads then ws.aim_speed_multiplier = ads * Config.adsSpeed end
        end

        -- pierce: client raycast (súng và melee) đọc max_piercings để đi xuyên nhiều target
        if Config.pierceOn then
            ws.max_piercings = Config.pierceCount
        end

        if not isMelee then
            if Config.noSpreadOn then
                ws.spread = 0
                ws.spread_base = 0
                ws.spread_aiming_multiplier = 0
            end
            if Config.noVisualRecoilOn then
                ws.visual_recoil_multiplier = 0
            end
        end
    end

    local gunHooked = false
    local function installGunHook()
        if gunHooked then return true end
        if not hookfunction then return false end
        local ok, createFn = pcall(function()
            return require(game:GetService("ReplicatedStorage").Functions.WeaponFramework.Gunsets.CreateFullGunset)
        end)
        if not ok or type(createFn) ~= "function" then return false end
        local wrap = newcclosure or function(f) return f end
        local okHook = pcall(function()
            local oldCreate
            oldCreate = hookfunction(createFn, wrap(function(...)
                local gunset, clamped = oldCreate(...)
                pcall(applyGunMods, gunset)
                return gunset, clamped
            end))
        end)
        gunHooked = okHook and true or false
        return gunHooked
    end

    -- CharacterStats: pump_speed_multiplier, reloading_speed_multiplier, infinite_bullets
    local pumpSet, reloadSet, infSet = false, false, false
    local function applyCharStats()
        local char  = lp.Character
        local stats = char and char:FindFirstChild("CharacterStats")
        if not stats then return end

        local pump = stats:FindFirstChild("pump_speed_multiplier")
        if pump and pump:IsA("NumberValue") then
            if Config.pumpSpeedOn then
                pump.Value = Config.pumpSpeed; pumpSet = true
            elseif pumpSet then
                pump.Value = 1; pumpSet = false
            end
        end

        local rel = stats:FindFirstChild("reloading_speed_multiplier")
        if rel and rel:IsA("NumberValue") then
            if Config.reloadSpeedOn then
                rel.Value = Config.reloadSpeed; reloadSet = true
            elseif reloadSet then
                rel.Value = 1; reloadSet = false
            end
        end

        local inf = stats:FindFirstChild("infinite_bullets")
        if inf and inf:IsA("BoolValue") then
            if Config.infiniteAmmo then
                inf.Value = true; infSet = true
            elseif infSet then
                inf.Value = false; infSet = false
            end
        end
    end

    task.spawn(function()
        while task.wait(0.25) do
            pcall(applyCharStats)
        end
    end)

    task.spawn(function()
        if not hookfunction then
            warn("[Tokai] executor không có hookfunction → gun mods không dùng được")
            return
        end
        for _ = 1, 40 do
            if installGunHook() then return end
            task.wait(0.5)
        end
        warn("[Tokai] không hook được CreateFullGunset")
    end)

    GunMods.getWeaponNames = getWeaponNames
    GunMods.applyCharStats = applyCharStats
end

-- Highlight: mỗi object là một object của Library.ESP (ESPType Highlight). Màu chỉnh ở tab ESP.
local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent or highlightObjects[obj] or not Library.ESP then return end
    local ok, esp = pcall(function()
        return Library.ESP:Add({
            Model = obj,
            Name = obj.Name,
            ESPType = "Highlight",
            Color = color,
            MaxDistance = 3000,
            OnDestroyFunc = function() highlightObjects[obj] = nil end,
        })
    end)
    if ok and esp then highlightObjects[obj] = esp end
end

local function RemoveHighlight(obj)
    local esp = highlightObjects[obj]
    highlightObjects[obj] = nil
    if esp and not esp.Deleted then pcall(function() esp:Destroy() end) end
end

-- ─── HITBOX EXPANDER ──────────────────────────────────────────────────────────

local function restoreHitbox(part)
    local orig = expandedHitboxes[part]
    if orig and part and part.Parent then
        pcall(function() part.Size = orig.size; part.Transparency = orig.transparency end)
    end
    expandedHitboxes[part] = nil
end

local function expandHitbox(part)
    if not part or not part:IsA("BasePart") or part.Name ~= "Head" then return end
    if not Config.hitboxExpander then return end
    local model = part.Parent
    if not model or not model:FindFirstChild("Humanoid") then return end
    if Players:GetPlayerFromCharacter(model) ~= nil then return end
    pcall(function()
        if not expandedHitboxes[part] then
            expandedHitboxes[part] = {size = part.Size, transparency = part.Transparency}
        end
        part.Size = Vector3.new(Config.hitboxSize, Config.hitboxSize, Config.hitboxSize)
        part.CanCollide = false; part.Transparency = 0.7
    end)
end

local function cleanupNPC(npcModel)
    local tracked = trackedNPCs[npcModel]
    if not tracked then return end
    for _, conn in ipairs(tracked.connections) do pcall(function() conn:Disconnect() end) end
    for _, part in ipairs(tracked.parts) do restoreHitbox(part) end
    trackedNPCs[npcModel] = nil
end

local function trackNPC(npcModel)
    if trackedNPCs[npcModel] then return end
    local humanoid = npcModel:FindFirstChild("Humanoid")
    if not humanoid then return end
    local connections, parts = {}, {}
    local head = npcModel:FindFirstChild("Head")
    if head then expandHitbox(head); table.insert(parts, head) end
    local c1 = npcModel.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and desc.Name == "Head" then
            task.wait(0.05); expandHitbox(desc); table.insert(parts, desc)
        end
    end)
    local c2 = humanoid.Died:Connect(function()
        task.wait(0.1); cleanupNPC(npcModel)
    end)
    local c3 = npcModel.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanupNPC(npcModel) end
    end)
    table.insert(connections, c1); table.insert(connections, c2); table.insert(connections, c3)
    trackedNPCs[npcModel] = {connections = connections, parts = parts}
end

local function untrackAllNPCs()
    for npc in pairs(trackedNPCs) do cleanupNPC(npc) end
    trackedNPCs = {}; expandedHitboxes = {}
end

-- ─── ENEMY CONTAINER ──────────────────────────────────────────────────────────

local function getEnemyContainer()
    return workspace.Game
        and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
        and workspace.Game.Current.Spawned.NPCs:FindFirstChild("enemies")
end

local function initHitboxExpander()
    local container = getEnemyContainer()
    if not container then return end
    for _, npc in ipairs(container:GetChildren()) do
        if npc:IsA("Model") then trackNPC(npc) end
    end
    container.ChildAdded:Connect(function(child)
        if Config.hitboxExpander and child:IsA("Model") then
            task.wait(0.1); trackNPC(child)
        end
    end)
end

task.spawn(function()
    while true do
        local container = getEnemyContainer()
        if container then
            initHitboxExpander()
            container.AncestryChanged:Wait()
            untrackAllNPCs()
        end
        task.wait(1)
    end
end)

