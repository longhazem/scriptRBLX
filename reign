local SKY_HEIGHT = 80
local skyPart    = nil
local skyConn    = nil
local skySavedCF = nil

local function getMapModel()
    local g   = workspace:FindFirstChild("Game")
    local cur = g and g:FindFirstChild("Current")
    local sc  = cur and cur:FindFirstChild("Scene")
    local m   = (sc and sc:FindFirstChild("Map")) or (cur and cur:FindFirstChild("Map"))
    if m and m:IsA("Model") then return m end
    return nil
end

local function getSkyPosition()
    local m = getMapModel()
    if not m then return nil end
    local cf, size = m:GetBoundingBox()
    return Vector3.new(cf.Position.X, cf.Position.Y + size.Y / 2 + SKY_HEIGHT, cf.Position.Z)
end

local function setSkyZone(on)
    Config.skyZone = on and true or false
    if skyConn then skyConn:Disconnect(); skyConn = nil end
    if skyPart then pcall(function() skyPart:Destroy() end); skyPart = nil end
    local char = lp.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not on then
        if hrp and skySavedCF then pcall(function() hrp.CFrame = skySavedCF end) end
        skySavedCF = nil
        return
    end
    local pos = getSkyPosition()
    if not (pos and hrp) then
        Config.skyZone = false
        notify("không tìm thấy map để tạo sky zone")
        return
    end
    skySavedCF = hrp.CFrame
    skyPart = Instance.new("Part")
    skyPart.Name = "TokaiSkyBlock"
    skyPart.Size = Vector3.new(12, 1, 12)
    skyPart.Anchored = true
    skyPart.CanCollide = true
    skyPart.CanTouch = false
    skyPart.CanQuery = false
    skyPart.Transparency = 1
    skyPart.Position = pos
    skyPart.Parent = workspace
    pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, skyPart.Size.Y / 2 + 3, 0)) end)
    skyConn = RunService.Heartbeat:Connect(function()
        if not Config.skyZone or not skyPart then return end
        local c = lp.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local newPos = getSkyPosition()
        if not (r and newPos) then return end
        skyPart.Position = newPos
        local stand = newPos + Vector3.new(0, skyPart.Size.Y / 2 + 3, 0)
        if (r.Position - stand).Magnitude > 5 then
            pcall(function() r.CFrame = CFrame.new(stand) end)
        end
    end)
end

-- ─── FPS BOOSTER V2 (port từ reignfall.txt: lưu từng property, khôi phục khi tắt) ─

local boosterV2On    = false
local boosterV2Saved = {}   -- [instance] = { prop = original }
local boosterV2Conn  = nil

local function saveV2(inst, prop, value)
    local rec = boosterV2Saved[inst]
    if not rec then rec = {}; boosterV2Saved[inst] = rec end
    if rec[prop] == nil then
        local okRead, orig = pcall(function() return inst[prop] end)
        if okRead and orig ~= nil then rec[prop] = orig end
    end
    pcall(function() inst[prop] = value end)
end

local function applyBoosterV2(d)
    if not boosterV2On or not d or not d.Parent then return end
    if d:IsA("BasePart") then
        saveV2(d, "CastShadow", false)
        saveV2(d, "Reflectance", 0)
        saveV2(d, "Material", Enum.Material.SmoothPlastic)
    elseif d:IsA("Decal") or d:IsA("Texture") then
        saveV2(d, "Transparency", 1)
    elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
        saveV2(d, "Enabled", false)
    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
        saveV2(d, "Enabled", false)
    end
end

local function setBoosterV2(on)
    boosterV2On = on and true or false
    Config.fpsBoosterV2 = boosterV2On
    if boosterV2On then
        saveV2(Lighting, "GlobalShadows", false)
        saveV2(Lighting, "FogEnd", 100000)
        for _, d in ipairs(workspace:GetDescendants()) do applyBoosterV2(d) end
        if not boosterV2Conn then
            boosterV2Conn = workspace.DescendantAdded:Connect(function(d)
                if boosterV2On then task.defer(applyBoosterV2, d) end
            end)
        end
    else
        if boosterV2Conn then boosterV2Conn:Disconnect(); boosterV2Conn = nil end
        for inst, rec in pairs(boosterV2Saved) do
            for prop, orig in pairs(rec) do
                pcall(function() inst[prop] = orig end)
            end
        end
        boosterV2Saved = {}
    end
end
local function WrapSection(Groupbox)
    local S = {}
    function S:AddToggle(Data)
        local Flag = tostring(Data.Flag or Data.Name or "T")
        local t = Groupbox:AddToggle(Flag, {Text=tostring(Data.Name or Flag), Default=Data.Default or false})
        if Data.Callback then t:OnChanged(Data.Callback) end
        return t
    end
    function S:AddSlider(Data)
        local Flag = tostring(Data.Flag or Data.Name or "S")
        local s = Groupbox:AddSlider(Flag, {Text=tostring(Data.Name or Flag), Default=Data.Default or 0, Min=Data.Min or 0, Max=Data.Max or 100, Rounding=Data.Rounding or 0, Suffix=Data.Suffix, Compact=Data.Compact or false})
        if Data.Callback then s:OnChanged(Data.Callback) end
        return s
    end
    function S:AddDropdown(Data)
        local Flag = tostring(Data.Flag or Data.Name or "D")
        local d = Groupbox:AddDropdown(Flag, {Text=tostring(Data.Name or Flag), Values=Data.Values or {}, Default=Data.Default, Multi=false})
        if Data.Callback then d:OnChanged(Data.Callback) end
        return d
    end
    function S:AddColorPicker(Data)
        local Flag = tostring(Data.Flag or Data.Name or "C")
        local label = Groupbox:AddLabel(tostring(Data.Name or Flag))
        label:AddColorPicker(Flag, {Default=Data.Default or Color3.new(1,1,1)})
        if Data.Callback and Options[Flag] then Options[Flag]:OnChanged(Data.Callback) end
    end
    function S:AddButton(Data)
        return Groupbox:AddButton(Data.Name or "Button", Data.Callback or function() end)
    end
    return S
end

local function DrawSection(Tab, Name, Position)
    if string.lower(Position or "left") == "right" then
        return WrapSection(Tab:AddRightGroupbox(Name))
    end
    return WrapSection(Tab:AddLeftGroupbox(Name))
end

