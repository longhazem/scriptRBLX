local RAYCAST_METHOD = "Raycast"
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Config.antiKick and self == lp and method:lower() == "kick" then return end

    -- Head Force: mọi lần RegisterHit đều đổi part thành Head (xem applyHeadForce)
    if Config.headForce and method == "FireServer" and typeof(self) == "Instance" and self.Name == "RegisterHit" then
        local argc = select("#", ...)
        local args = {...}
        applyHeadForce(args[1])
        return oldNamecall(self, table.unpack(args, 1, argc))
    end

    -- Silent Aim + No Spread
    if method == RAYCAST_METHOD and self == Workspace then
        local origin, dir, params = ...
        if params and params.CollisionGroup == "raycast_npc_neutral" then
            local doSpread = Config.noSpread
            local doSilent = Config.raycasting and target.position ~= nil
            if doSpread or doSilent then
                if doSpread then dir = camera.CFrame.LookVector * dir.Magnitude end
                if doSilent then
                    local toTarget = target.position - origin
                    if toTarget.Magnitude > 0.001 then dir = toTarget.Unit * dir.Magnitude end
                end
                return oldNamecall(self, origin, dir, params)
            end
        end
    end

    return oldNamecall(self, ...)
end))

