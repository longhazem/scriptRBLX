        end
        notify("FPS Booster: ON")
    else
        for _, rec in ipairs(boosterSaved) do
            pcall(function() rec[1][rec[2]] = rec[3] end)
        end
        boosterSaved = {}
        notify("FPS Booster: OFF")
    end
end

