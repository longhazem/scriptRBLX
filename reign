local function setPath(root, path, value)
    local t = root
    for i = 1, #path - 1 do
        local k = path[i]
        if type(t[k]) ~= "table" then t[k] = {} end
        t = t[k]
    end
    t[path[#path]] = value
end

local function getPath(root, path)
    local t = root
    for _, k in ipairs(path) do
        if type(t) ~= "table" then return nil end
        t = t[k]
        if t == nil then return nil end
    end
    return t
end

-- GlobalConfig = OR của hai page cho các thành phần vẽ dùng chung.
local function applyESPGlobals()
    local lib = Library.ESP
    if not (lib and lib.GlobalConfig) then return end
    local G, Z, P = lib.GlobalConfig, ESPZ, ESPP
    G.Boxes2D = (Z.Box2D or P.Box2D) and true or false
    G.Boxes3D = (Z.Box3D or P.Box3D) and true or false
    G.Health = (Z.Health or P.Health) and true or false
    G.Tracers = (Z.Tracer or P.Tracer) and true or false
    G.Arrows = (Z.Arrow or P.Arrow) and true or false
    G.Skeleton = (Z.Skeleton or P.Skeleton) and true or false
    G.Highlighters = (Z.Highlight or P.Highlight) and true or false
    G.Billboards = Z.Name and true or false
    G.Distance = (Z.ShowDist or P.ShowDist) and true or false
end

-- Page Player: đẩy mọi cài đặt có lib vào Library.ESP rồi đồng bộ template cho các player đang có.
local function applyPlayerESP()
    local lib = Library.ESP
    if not lib then return end
    for _, s in ipairs(PLAYER_SPEC) do
        if s.lib then pcall(setPath, lib, s.lib, ESPP[s.k]) end
    end
    pcall(setPath, lib, { 'Settings', 'ESPType' }, ESPP.Highlight and 'Highlight' or 'Text')
    pcall(function() lib:ApplyTemplate() end)
    applyESPGlobals()
end

-- Page Zombie: object riêng cho từng zombie. Đổi cài đặt thì tăng zombieVer, zombie cũ được dựng lại.
local zombieObjs = {}     -- [Model] = { obj = object của Library.ESP, ver = phiên bản cài đặt }
local zombieVer = 0

local function zombieSettings(npc)
    local c = ESPZ
    return {
        Model = npc,
        Name = npc.Name,
        ESPType = c.Highlight and 'Highlight' or 'Text',
        Color = c.Color,
        MaxDistance = c.MaxDistance,
        HighlightDepth = c.HighlightDepth,
        FillTransparency = c.FillTransparency,
        OutlineTransparency = c.OutlineTransparency,
        Box2D = { Enabled = c.Box2D, Style = c.Box2DStyle, Filled = c.Box2DFilled, Color = c.Color },
        Box3D = { Enabled = c.Box3D, Color = c.Color },
        Health = { Enabled = c.Health, Side = c.HealthSide, Gradient = c.HealthGradient },
        Tracer = { Enabled = c.Tracer, From = c.TracerFrom, Color = c.Color },
        Arrow = { Enabled = c.Arrow, Shape = c.ArrowShape, Placement = c.ArrowPlacement, Size = c.ArrowSize, Color = c.Color },
        Skeleton = { Enabled = c.Skeleton, Color = c.Color },
    }
end

local function removeZombieObj(npc)
    local rec = zombieObjs[npc]
    zombieObjs[npc] = nil
    if rec and rec.obj and not rec.obj.Deleted then pcall(function() rec.obj:Destroy() end) end
end

local function syncZombieESP()
    if not Library.ESP then return end
    local alive = {}
    local container = ESPZ.Enabled and getEnemyContainer() or nil
    if container then
        for _, npc in ipairs(container:GetChildren()) do
            if npc:IsA('Model') and not Players:GetPlayerFromCharacter(npc) then
                local hum = npc:FindFirstChildOfClass('Humanoid')
                if hum and hum.Health > 0 then
                    alive[npc] = true
                    local rec = zombieObjs[npc]
                    if not rec or rec.ver ~= zombieVer then
                        removeZombieObj(npc)
                        local ok, obj = pcall(function() return Library.ESP:Add(zombieSettings(npc)) end)
                        if ok and obj then zombieObjs[npc] = { obj = obj, ver = zombieVer } end
                    end
                end
            end
        end
    end
    for npc in pairs(zombieObjs) do
        if not alive[npc] then removeZombieObj(npc) end
    end
end

local function applyZombieESP()
    applyESPGlobals()
    zombieVer = zombieVer + 1
    pcall(syncZombieESP)
end

local entityESPNext = 0
UpdateEntityESP = function()
    local now = os.clock()
    if now < entityESPNext then return end
    entityESPNext = now + 0.25
    pcall(syncZombieESP)
end

-- Đồng bộ UI với Library.ESP (khi mở, khi nhập preset).
local espHandles = {}     -- [Flag] = element của page Player
local function pullESPFromLib()
    local lib = Library.ESP
    if not lib then return end
    for _, s in ipairs(PLAYER_SPEC) do
        if s.lib then
            local v = getPath(lib, s.lib)
            if v ~= nil then
                ESPP[s.k] = v
                local h = espHandles[s.f]
                if h and h.Set then pcall(function() h:Set(v, true) end) end
            end
        end
    end
end

local function onESPChanged(isPlayer)
    if isPlayer then applyPlayerESP() else applyZombieESP() end
end

local function specToElement(page, groups, s, state, isPlayer)
    local g = groups[s.g]
    if not g then
        groups._n = (groups._n or 0) + 1
        g = page:CreateGroupbox({ Name = s.g, Side = (groups._n % 2 == 1) and 'Left' or 'Right' })
        groups[s.g] = g
    end
    local h
    if s.t == 'toggle' then
        h = g:CreateToggle({
            Name = s.n, Flag = s.f, CurrentValue = state[s.k] == true,
            Callback = function(v) state[s.k] = v and true or false; onESPChanged(isPlayer) end,
        })
    elseif s.t == 'slider' then
        h = g:CreateSlider({
            Name = s.n, Flag = s.f, Range = { s.min, s.max }, Increment = s.inc,
            Suffix = s.sfx or '', CurrentValue = state[s.k] or s.min,
            Callback = function(v) state[s.k] = v; onESPChanged(isPlayer) end,
        })
    elseif s.t == 'dropdown' then
        h = g:CreateDropdown({
            Name = s.n, Flag = s.f, Options = s.o, CurrentOption = state[s.k],
            MultipleOptions = false, AllowNone = false,
            Callback = function(v) state[s.k] = v; onESPChanged(isPlayer) end,
        })
    elseif s.t == 'color' then
        h = g:CreateColorPicker({
            Name = s.n, Flag = s.f, Color = state[s.k],
            Callback = function(c) state[s.k] = c; onESPChanged(isPlayer) end,
        })
    end
    if h then espHandles[s.f] = h end
    return h
end

buildESPTab = function(tab)
    if not tab then return end
    if not Library.ESP then
        tab:CreateParagraph({ Title = 'ESP chưa tải', Content = 'Không tải được ESP.luau từ repo HawkTokaiLib. Kiểm tra file ESP.luau ở root rồi chạy lại.' })
        return
    end
    pullESPFromLib()
    local zPage = tab:CreateSubTab({ Name = 'Zombie' })
    local pPage = tab:CreateSubTab({ Name = 'Player' })
    local zGroups, pGroups = {}, {}
    for _, s in ipairs(ZOMBIE_SPEC) do specToElement(zPage, zGroups, s, ESPZ, false) end
    for _, s in ipairs(PLAYER_SPEC) do specToElement(pPage, pGroups, s, ESPP, true) end

    local pre = pPage:CreateGroupbox({ Name = 'Preset', Side = 'Right' })
    pre:CreateButton({
        Name = 'Xuất preset (chép vào clipboard)',
        Callback = function()
            local ok, text = pcall(function() return Library.ESP:Export() end)
            if ok and text then
                pcall(function() setclipboard(text) end)
                Library:Notify({ Title = 'ESP', Content = 'Đã xuất preset', Duration = 2 })
            end
        end,
    })
    local importText = ''
    pre:CreateInput({
        Name = 'Preset JSON', PlaceholderText = 'dán JSON vào đây', CurrentValue = '',
        Callback = function(text) importText = tostring(text or '') end,
    })
    pre:CreateButton({
        Name = 'Nhập preset',
        Callback = function()
            local ok, res, reason = pcall(function() return Library.ESP:Import(importText) end)
            if ok and res then
                pullESPFromLib()
                applyPlayerESP()
                Library:Notify({ Title = 'ESP', Content = 'Đã nhập preset', Duration = 2 })
            else
                Library:Notify({ Title = 'ESP', Content = tostring(reason or res or 'preset không hợp lệ'), Duration = 3 })
            end
        end,
    })

    applyPlayerESP()
    applyZombieESP()
end
end

