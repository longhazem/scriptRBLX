-- ─── HEAD FORCE: đổi part của mọi hit gửi lên RegisterHit thành Head của target ───
-- Server đọc part của từng entry để tính sát thương (headshot); mình đổi part trước khi gửi.
local function applyHeadForce(hits)
    if type(hits) ~= "table" then return end
    local myChar = lp.Character
    for _, entry in ipairs(hits) do
        local target = type(entry) == "table" and entry.target
        if typeof(target) == "Instance" and target ~= myChar then
            local head = target:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                entry.part = head
                if type(entry.cast_results) == "table" then
                    entry.cast_results.part = head
                end
            end
        end
    end
end

