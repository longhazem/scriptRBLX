local lastReloadAt = {}
local function kickReload(tool)
    if not Config.autoReload or not tool then return end
    if (lastReloadAt[tool] or 0) > os.clock() - 1 then return end
    lastReloadAt[tool] = os.clock()
    local se = tool:FindFirstChild("ServerEvents")
    local rl = se and se:FindFirstChild("ReloadAmmo")
    if rl and rl:IsA("RemoteEvent") then pcall(function() rl:FireServer(false) end) end
end

local function getHitPart(npc)
    return npc:FindFirstChild("Head") or npc:FindFirstChild("Torso") or npc:FindFirstChild("HumanoidRootPart")
end

local function isAliveNPC(npc)
    local hum = npc:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- đúng điều kiện server RegisterHit kiểm tra: có PrimaryPart + CanSourceAttackTarget(attacker, target, true, false)
local function isValidTarget(npc)
    if not npc:IsA("Model") or npc.PrimaryPart == nil then return false end
    if not isAliveNPC(npc) then return false end
    local fn = getCanAttack()
    if fn then
        local ok, res = pcall(fn, lp.Character, npc, true, false)
        if not (ok and res) then return false end
    end
    return true
end

-- cast_results khớp GetRaycastInfoTableFromRaycastResults của game: {part, pos, normal, material, distance}
local function buildCastResults(part)
    local cam    = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position or part.Position
    local pos    = part.Position
    local toCam  = origin - pos
    local normal = Vector3.new(0, 1, 0)
    if toCam.Magnitude > 0.001 then normal = toCam.Unit end
    return {
        part     = part,
        pos      = pos,
        normal   = normal,
        material = part.Material,
        distance = (pos - origin).Magnitude,
    }
end

local function collectHitTargets(wantZombies, wantBosses, wantBulwark)
    local out = {}
    local function add(npc, kind)
        if not isValidTarget(npc) then return end
        local part = getHitPart(npc)
        if part then table.insert(out, {model = npc, part = part, kind = kind}) end
    end

    if wantZombies or wantBulwark then
        local enemies = getNamedFolder("Game", "Current", "Spawned", "NPCs", "enemies")
        if enemies then
            for _, npc in ipairs(enemies:GetChildren()) do
                if npc.Name == BULWARK_NAME then
                    if wantBulwark then add(npc, "bulwark") end
                elseif wantZombies then
                    add(npc, "zombie")
                end
            end
        end
    end

    if wantZombies then
        local ragdolls = getNamedFolder("Game", "Spawned", "Ragdolls")
        local corpses  = getNamedFolder("Game", "Current", "Scene", "Map", "Corpses")
        if ragdolls then
            for _, npc in ipairs(ragdolls:GetChildren()) do add(npc, "zombie") end
        end
        if corpses then
            for _, npc in ipairs(corpses:GetChildren()) do add(npc, "zombie") end
        end
    end

    if wantBosses then
        local bosses = getNamedFolder("Game", "Current", "Spawned", "NPCs", "bosses")
        if bosses then
            for _, npc in ipairs(bosses:GetChildren()) do add(npc, "boss") end
        end
    end

    return out
end

local function fireHits(targets)
    if #targets == 0 then return end
    local char = lp.Character
    if not char then return end

    -- mỗi slot đang bật + có tool + có budget thì thành một "kênh" bắn
    local channels = {}
    for _, slotName in ipairs(HIT_SLOTS) do
        local enabled = (slotName == "primary" and Config.hitPrimary)
            or (slotName == "secondary" and Config.hitSecondary)
            or (slotName == "melee" and Config.hitMelee)
        if enabled then
            local tool  = getSlotTool(slotName)
            local event = getSlotHitEvent(tool)
            if event then
                local isMelee = (slotName == "melee")
                local budget  = isMelee and math.huge or (getBudget(tool) or 0)
                if budget < 1 then
                    kickReload(tool)
                else
                    table.insert(channels, {event = event, isMelee = isMelee, remaining = budget})
                end
            end
        end
    end
    if #channels == 0 then return end

    local normalHits, bulwarkHits = {}, {}
    for _, t in ipairs(targets) do
        local cast = buildCastResults(t.part)
        if cast.distance <= Config.autoHitRange then
            local entry = {
                cast_results = cast,
                part         = t.part,
                amount       = 1,
                is_friendly  = false,
                target       = t.model,
            }
            if t.kind == "bulwark" then
                table.insert(bulwarkHits, entry)
            else
                table.insert(normalHits, entry)
            end
        end
    end

    for _, ch in ipairs(channels) do
        -- một lần gọi RegisterHit = một lần trừ budget, nên gom tất cả target vào một lần gọi
        if #normalHits > 0 and ch.remaining >= 1 then
            ch.remaining = ch.remaining - 1
            pcall(function()
                if ch.isMelee then
                    ch.event:FireServer(normalHits, {}, nil, true, false)
                else
                    ch.event:FireServer(normalHits, {})
                end
            end)
        end
        for _, entry in ipairs(bulwarkHits) do
            if ch.remaining < 1 then break end
            ch.remaining = ch.remaining - 1
            local root    = char:FindFirstChild("HumanoidRootPart")
            local backPos = getBulwarkBackPosition(entry.target)
            if root and backPos then
                local original = root.CFrame
                pcall(function() root.CFrame = CFrame.new(backPos, entry.part.Position) end)
                pcall(function()
                    if ch.isMelee then
                        ch.event:FireServer({entry}, {}, nil, true, false)
                    else
                        ch.event:FireServer({entry}, {})
                    end
                end)
                pcall(function() root.CFrame = original end)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        local zombiesOn   = Config.autoHit or Config.churchFarm
        local wantZombies = zombiesOn and not Config.bulwarkOnly
