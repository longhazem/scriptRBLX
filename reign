local function WrapSection(Groupbox)
    local S = {}
    function S:AddToggle(Data)
        local Flag = tostring(Data.Flag or Data.Name or "T")
        return Groupbox:CreateToggle({
            Name = tostring(Data.Name or Flag),
            Flag = Flag,
            CurrentValue = Data.Default == true,
            Callback = Data.Callback or function() end,
        })
    end
    function S:AddSlider(Data)
        local Flag = tostring(Data.Flag or Data.Name or "S")
        local digits = tonumber(Data.Rounding) or 0
        return Groupbox:CreateSlider({
            Name = tostring(Data.Name or Flag),
            Flag = Flag,
            Range = { Data.Min or 0, Data.Max or 100 },
            Increment = 10 ^ (-digits),
            Suffix = Data.Suffix or "",
            CurrentValue = Data.Default or Data.Min or 0,
            Callback = Data.Callback or function() end,
        })
    end
    function S:AddDropdown(Data)
        local Flag = tostring(Data.Flag or Data.Name or "D")
        local values = Data.Values or {}
        return Groupbox:CreateDropdown({
            Name = tostring(Data.Name or Flag),
            Flag = Flag,
            Options = values,
            CurrentOption = Data.Default or values[1],
            MultipleOptions = false,
            AllowNone = true,
            Callback = Data.Callback or function() end,
        })
    end
    function S:AddButton(Data)
        return Groupbox:CreateButton({
            Name = tostring(Data.Name or "Button"),
            Callback = Data.Callback or function() end,
        })
    end
    return S
end

