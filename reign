-- ─── FPS BOOSTER V2 (port từ reignfall.txt: lưu từng property, khôi phục khi tắt) ─

local boosterV2On    = false
local boosterV2Saved = {}   -- [instance] = { prop = original }
local boosterV2Conn  = nil

local function saveV2(inst, prop, value)
    local rec = boosterV2Saved[inst]
    if not rec then rec = {}; boosterV2Saved[inst] = rec end
    if rec[prop] == nil then
        local okRead, orig = pcall(function() return inst[prop] end)
        if okRead and orig ~= nil then rec[prop] = orig end
    end
    pcall(function() inst[prop] = value end)
end

local function applyBoosterV2(d)
    if not boosterV2On or not d or not d.Parent then return end
    if d:IsA("BasePart") then
        saveV2(d, "CastShadow", false)
        saveV2(d, "Reflectance", 0)
        saveV2(d, "Material", Enum.Material.SmoothPlastic)
    elseif d:IsA("Decal") or d:IsA("Texture") then
        saveV2(d, "Transparency", 1)
    elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
        saveV2(d, "Enabled", false)
    elseif d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
        saveV2(d, "Enabled", false)
    end
end

local function setBoosterV2(on)
    boosterV2On = on and true or false
    Config.fpsBoosterV2 = boosterV2On
    if boosterV2On then
        saveV2(Lighting, "GlobalShadows", false)
        saveV2(Lighting, "FogEnd", 100000)
        for _, d in ipairs(workspace:GetDescendants()) do applyBoosterV2(d) end
        if not boosterV2Conn then
            boosterV2Conn = workspace.DescendantAdded:Connect(function(d)
                if boosterV2On then task.defer(applyBoosterV2, d) end
            end)
        end
    else
        if boosterV2Conn then boosterV2Conn:Disconnect(); boosterV2Conn = nil end
        for inst, rec in pairs(boosterV2Saved) do
            for prop, orig in pairs(rec) do
                pcall(function() inst[prop] = orig end)
            end
        end
        boosterV2Saved = {}
    end
end
